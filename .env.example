# Copy to .env. Server-only secrets; never place these in miniprogram/.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_TIMEOUT_MS=90000
PORT=4173
SQLITE_PATH=server/data/image-outfit.sqlite
HOST=127.0.0.1
CUTOUT_PYTHON=python
NODE_ENV=development
# Production requires a valid WeChat app and HTTPS reverse proxy.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional skin-provider comparison credentials (server-side only).
# Use trial accounts/credits for evaluation; these do not switch the live report provider.
FACEPLUSPLUS_API_KEY=
FACEPLUSPLUS_API_SECRET=
PERFECTCORP_API_KEY=
