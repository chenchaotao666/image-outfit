page{background:#fff}.mine{padding:55rpx 30rpx;min-height:90vh}.profile{display:flex;align-items:center;gap:25rpx;padding:30rpx 10rpx 65rpx}.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#dcefed;color:#26666a;display:flex;justify-content:center;align-items:center;font-family:Georgia,serif;font-size:58rpx;position:relative;overflow:hidden}.avatar view{position:absolute;width:100rpx;height:25rpx;bottom:0;background:#bad9cc;transform:rotate(-15deg)}.profile-name{font-size:31rpx;font-weight:600;margin-bottom:8rpx}.profile .muted{font-size:22rpx}.account-list{background:#fafafa}.account-item{display:flex;align-items:center;justify-content:space-between;padding:24rpx 25rpx;border-bottom:1rpx solid #f1f2f2;font-size:26rpx}.account-item>view{display:flex;align-items:center;gap:18rpx}.count{font-size:22rpx;color:#bbb}.second-list{margin-top:26rpx}.mine-brand{text-align:center;color:#aec1c1;margin-top:130rpx;font-size:25rpx;letter-spacing:3rpx}.mine-brand view{font-size:19rpx;margin:10rpx}.mine-brand>text{font-size:18rpx;color:#c1c8c8;letter-spacing:0}
