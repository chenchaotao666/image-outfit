.reports-page{padding:36rpx 28rpx 60rpx;background:linear-gradient(#eaf9f8,#f5f6f6 550rpx);min-height:100vh}.reports-heading{padding:35rpx 12rpx 55rpx}.reports-heading .eyebrow{color:#6ea9aa;font-size:18rpx;margin-bottom:22rpx}.reports-heading .title{font-weight:500;line-height:1.6}.reports-heading .muted{margin-top:18rpx}.empty-report{width:80rpx;height:80rpx;margin:0 auto 30rpx;opacity:.5}.empty .notice{margin:20rpx 0 35rpx}.empty .link{margin:28rpx auto 0}.saved-report{padding:30rpx;margin-bottom:24rpx}.saved-body{display:flex;align-items:center;gap:20rpx;margin:25rpx 0}.saved-body image{width:100rpx;height:130rpx;flex-shrink:0}.saved-body .section-title{font-size:27rpx}.saved-body .muted{font-size:23rpx;margin:8rpx 0}.report-tags{font-size:19rpx;color:#75b5b7}.report-actions{border-top:1rpx solid #f0f3f3;padding-top:20rpx}.delete-link{font-size:22rpx;color:#aaa}.new-report{margin:40rpx 0}.storage-note{text-align:center;font-size:21rpx;color:#aab5b5;padding:30rpx}
