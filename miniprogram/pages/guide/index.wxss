.guide{padding:35rpx 28rpx 180rpx;background:linear-gradient(#edf9f7,#f5f6f6)}.guide-header{padding:35rpx 15rpx 45rpx}.guide-header .eyebrow{color:#84acaa;font-size:17rpx}.guide-header .title{font-size:47rpx;font-weight:500;line-height:1.6;margin:25rpx 0}.steps{padding:10rpx 32rpx}.step{display:flex;gap:25rpx;padding:32rpx 0;border-bottom:1rpx solid #edf2f2}.step:last-child{border:0}.step-number{font-size:40rpx;color:#6abcb9;font-family:Georgia,serif;line-height:1.3}.step .section-title{font-size:29rpx;margin-bottom:12rpx}.faq-heading{padding:40rpx 5rpx 25rpx}.faq{padding:25rpx;border-bottom:1rpx solid #eee;font-size:26rpx}.faq .notice{padding:18rpx 0 0}.faq .row>text:first-child{flex:1}
