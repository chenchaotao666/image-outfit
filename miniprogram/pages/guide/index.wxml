<view class="guide bottom-pad"><view class="guide-header"><view class="eyebrow">START YOUR STYLE JOURNEY</view><view class="title">简单四步<text>
</text>认识更好的自己</view><view class="muted">AI 穿搭分析 · 使用指南</view></view><view class="steps card"><view wx:for="{{steps}}" wx:key="no" class="step"><text class="step-number">{{item.no}}</text><view><view class="section-title">{{item.title}}</view><view class="notice">{{item.text}}</view></view></view></view><view class="section-title faq-heading">你可能想了解</view><view class="card"><view wx:for="{{faq}}" wx:key="q" class="faq"><view class="row" data-index="{{index}}" bindtap="toggle"><text>{{item.q}}</text><text class="arrow">{{expanded === index ? '−' : '+'}}</text></view><view wx:if="{{expanded === index}}" class="notice">{{item.a}}</view></view></view><view class="fixed-bottom"><button class="primary" bindtap="start">开始检测体验</button></view></view>
