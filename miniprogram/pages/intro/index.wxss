page{background:#181d1c}.intro{background:#fff}.intro-top{background:#181d1c;color:#fff;padding:20rpx 30rpx;font-size:27rpx;font-weight:600}.intro-menu{color:#aaa;font-weight:400}.intro-hero{height:650rpx;position:relative;background:#253332}.intro-hero>image{width:100%;height:100%;opacity:.5}.intro-hero-copy{position:absolute;inset:0;padding:70rpx 42rpx;background:linear-gradient(90deg,#152b2bd9,transparent);color:white}.intro-hero-copy .eyebrow{font-size:18rpx;color:#bbd9d3}.intro-title{font-size:65rpx;line-height:1.4;letter-spacing:6rpx;margin-top:40rpx;font-weight:300}.intro-sub{margin-top:35rpx;font-size:24rpx;color:#d4e1df;letter-spacing:3rpx}.advantages{background:#192624;color:white;padding:50rpx 35rpx}.outline-word{font-size:60rpx;letter-spacing:4rpx;opacity:.15;font-weight:700;margin-bottom:10rpx}.advantages .section-title{font-weight:400;font-size:30rpx}.feature-grid{display:flex;justify-content:space-between;margin-top:45rpx}.feature-grid>view{text-align:center}.feature-grid text{border:1rpx solid #7a9690;width:90rpx;height:90rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:27rpx}.feature-grid>view>view{color:#90a69f;font-size:18rpx;margin-top:18rpx}.intro-features{padding:0 42rpx}.intro-feature{padding:65rpx 0;border-bottom:1rpx solid #eee}.feature-no{font-family:Georgia,serif;font-size:70rpx;font-style:italic;line-height:1.2}.intro-feature .eyebrow{color:#9daca7;font-size:17rpx;margin:16rpx 0}.feature-description{font-size:26rpx;color:#8b9692;line-height:1.9;margin:25rpx 0}.feature-face{display:flex;align-items:center;gap:50rpx;background:#f5f9f7;margin-top:35rpx;padding:30rpx;font-size:32rpx}.feature-face image{width:160rpx;height:230rpx;mix-blend-mode:multiply}.feature-face text{font-size:22rpx;color:#94a8a0}.ratio-art{display:flex;gap:20rpx;align-items:flex-end;height:180rpx;background:#f8faf8;padding:30rpx}.ratio-art view{flex:1;background:#afc7ba;height:70%}.ratio-art view:nth-child(2){height:100%;background:#54776a}.ratio-art view:nth-child(3){height:50%;background:#d8d7c1}.color-art{display:flex;height:130rpx;gap:12rpx;margin-top:35rpx}.color-art view{flex:1;background:#ddcebc;border-radius:50rpx}.color-art view:nth-child(2){background:#a6b1a0}.color-art view:nth-child(3){background:#c3a88c}.color-art view:nth-child(4){background:#63766b}.color-art view:nth-child(5){background:#797269}.intro-bottom{text-align:center;padding:65rpx 35rpx;background:#f2f6f3}.intro-bottom .eyebrow{font-size:16rpx;color:#91a79e;margin-bottom:25rpx}.intro-bottom .title{font-weight:400;line-height:1.8}.intro-bottom .secondary{margin:40rpx 0;border-radius:0;border-color:#39584e;color:#39584e}.intro-footer{position:fixed;bottom:0;left:0;right:0;display:flex;gap:20rpx;padding:20rpx 25rpx;background:#fff;z-index:20}.manual{width:230rpx;padding:18rpx;border:1rpx solid #536f66;color:#536f66;font-size:25rpx}.experience{flex:1;padding:18rpx;background:#31584e;color:white;font-size:25rpx}
