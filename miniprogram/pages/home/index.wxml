<view class="home">
  <image class="hero" src="/assets/home-hero.jpg" mode="aspectFill" />
  <view class="hero-shade"></view>
  <view class="brand" style="top:{{top}}px"><text class="brand-mark">Y</text><text>AI 穿搭分析<text class="brand-en">IMAGE & STYLE</text></text></view>
  <view class="home-actions">
    <button class="home-entry" bindtap="wardrobe">
      <view class="entry-icon closet-icon" aria-hidden="true"></view>
      <view class="entry-copy"><text>My衣橱管家</text><text class="entry-subtitle">收纳衣橱 · 记录穿搭</text></view>
      <view class="entry-chevron" aria-hidden="true"></view>
    </button>
    <button class="home-entry" bindtap="bangda">
      <text class="entry-icon" aria-hidden="true">✧</text>
      <view class="entry-copy"><text>帮搭</text><text class="entry-subtitle">发现穿搭灵感</text></view>
      <view class="entry-chevron" aria-hidden="true"></view>
    </button>
    <view class="ticker">发现适合你的风格，让穿搭更懂你</view>
    <button class="camera-button" bindtap="start" aria-label="开始AI穿搭检测"><view class="camera-icon"><view class="camera-lens"></view></view></button>
    <view class="home-caption">开启你的形象探索</view>
  </view>
  <view wx:if="{{introOpen}}" class="intro-mask">
    <view class="intro-card">
      <view class="intro-name">AI智能形象穿搭</view>
      <view class="intro-copy">提升衣品，从这一刻开启！</view>
      <button bindtap="enterDetection">上传照片即可检测</button>
    </view>
    <button class="intro-close" bindtap="closeIntro" aria-label="关闭检测介绍">×</button>
  </view>
</view>
