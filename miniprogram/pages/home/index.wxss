page{background:#0c101b}.home{height:100vh;position:relative;overflow:hidden;color:#fff}.hero{width:100%;height:100%;position:absolute;inset:0}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,10,24,.2),transparent 35%,rgba(3,10,15,.08) 60%,rgba(0,5,10,.95))}.brand{position:absolute;left:34rpx;display:flex;align-items:center;gap:14rpx;font-size:23rpx;letter-spacing:3rpx;opacity:.85}.brand-mark{font-family:Georgia,serif;font-size:44rpx;border-bottom:2rpx solid #00c8c9;line-height:1.1}.brand-en{display:block;font-size:11rpx;letter-spacing:3rpx;opacity:.65}.home-actions{position:absolute;bottom:42rpx;left:0;width:100%;display:flex;flex-direction:column;align-items:center}.ticker{max-width:560rpx;background:linear-gradient(90deg,transparent,rgba(0,139,151,.28),transparent);border-radius:50rpx;padding:10rpx 40rpx;font-size:23rpx;letter-spacing:1rpx;margin-bottom:34rpx}.camera-button{width:116rpx;height:116rpx;border-radius:50%;background:linear-gradient(140deg,#00dcd1,#00aec9);display:flex;align-items:center;justify-content:center;box-shadow:0 0 38rpx #00bbbe25}.camera-icon{position:relative;border:4rpx solid white;border-radius:7rpx;width:44rpx;height:34rpx;display:flex;align-items:center;justify-content:center}.camera-icon::before{content:"";position:absolute;top:-11rpx;width:19rpx;height:8rpx;border:4rpx solid #fff;border-bottom:0;border-radius:4rpx 4rpx 0 0}.camera-lens{width:19rpx;height:19rpx;border:3rpx solid #fff;border-radius:50%}.home-caption{font-size:21rpx;letter-spacing:4rpx;opacity:.75;margin-top:24rpx}.sample-link{font-size:20rpx;color:#c0cecf;margin-top:20rpx;padding:10rpx}.sample-link text{margin-left:12rpx}

.wardrobe-entry{position:absolute;top:150rpx;left:32rpx;right:32rpx;display:flex;align-items:center;gap:24rpx;padding:24rpx 28rpx;background:rgba(255,255,255,.13);border:1rpx solid #ffffff30;border-radius:18rpx;color:#fff;text-align:left;backdrop-filter:blur(12px)}.wardrobe-entry>view{flex:1;font-size:29rpx}.entry-subtitle{display:block;font-size:20rpx;color:#d5dedc;margin-top:5rpx}.entry-symbol{font-size:42rpx}

.bangda-home-link{display:flex;align-items:center;gap:20rpx;margin-bottom:28rpx;border:1rpx solid #ffdfbb45;border-radius:40rpx;padding:14rpx 34rpx;color:#ffe0c3;background:linear-gradient(115deg,#fbdec229,#e4b3aa18);font-size:25rpx}.bangda-home-link text:first-child{font-size:36rpx}
