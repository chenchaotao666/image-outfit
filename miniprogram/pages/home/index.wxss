page{background:#0c101b}.home{height:100vh;position:relative;overflow:hidden;color:#fff}.hero{width:100%;height:100%;position:absolute;inset:0}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,10,24,.2),transparent 35%,rgba(3,10,15,.08) 60%,rgba(0,5,10,.95))}.brand{position:absolute;left:34rpx;display:flex;align-items:center;gap:14rpx;font-size:23rpx;letter-spacing:3rpx;opacity:.85}.brand-mark{font-family:Georgia,serif;font-size:44rpx;border-bottom:2rpx solid #00c8c9;line-height:1.1}.brand-en{display:block;font-size:11rpx;letter-spacing:3rpx;opacity:.65}.home-actions{position:absolute;bottom:42rpx;left:0;width:100%;display:flex;flex-direction:column;align-items:center}.ticker{max-width:560rpx;background:linear-gradient(90deg,transparent,rgba(0,139,151,.28),transparent);border-radius:50rpx;padding:10rpx 40rpx;font-size:23rpx;letter-spacing:1rpx;margin-bottom:34rpx}.camera-button{width:116rpx;height:116rpx;border-radius:50%;background:linear-gradient(140deg,#00dcd1,#00aec9);display:flex;align-items:center;justify-content:center;box-shadow:0 0 38rpx #00bbbe25}.camera-icon{position:relative;border:4rpx solid white;border-radius:7rpx;width:44rpx;height:34rpx;display:flex;align-items:center;justify-content:center}.camera-icon::before{content:"";position:absolute;top:-11rpx;width:19rpx;height:8rpx;border:4rpx solid #fff;border-bottom:0;border-radius:4rpx 4rpx 0 0}.camera-lens{width:19rpx;height:19rpx;border:3rpx solid #fff;border-radius:50%}.home-caption{font-size:21rpx;letter-spacing:4rpx;opacity:.75;margin-top:24rpx}

.home-actions .home-entry {
  display:flex; align-items:center; gap:20rpx; width:400rpx; max-width:90%; height:84rpx;
  margin:0 0 18rpx; padding:0 30rpx; border:1rpx solid #ffffff48; border-radius:48rpx;
  background:rgba(23,31,39,.88); color:#fff; text-align:left;
}
.entry-copy {flex:1; min-width:0; font-size:26rpx; font-weight:600; line-height:1.25}
.entry-subtitle {display:block; margin-top:3rpx; color:#cbd7d8; font-size:20rpx; font-weight:400}
.entry-icon {display:flex; align-items:center; justify-content:center; width:30rpx; height:30rpx; flex:none; color:#d6e7e6; font-size:36rpx; line-height:1}
.closet-icon {position:relative; border:2rpx solid #d6e7e6; border-radius:4rpx}
.closet-icon::after {content:""; height:100%; border-left:2rpx solid #d6e7e6}
.entry-chevron {width:12rpx; height:12rpx; flex:none; border:solid #d6e7e6; border-width:2rpx 2rpx 0 0; transform:rotate(45deg)}

.home .camera-button {width:116rpx;height:116rpx;margin:0;padding:0}
.intro-mask {position:absolute;inset:0;z-index:10;display:flex;flex-direction:column;justify-content:center;align-items:center;background:rgba(0,0,0,.82)}
.intro-card {position:relative;overflow:hidden;width:80%;padding:125rpx 20rpx 70rpx;border-radius:20rpx;text-align:center;background:radial-gradient(circle at 13% 27%,#ffffff63,transparent 17%),radial-gradient(circle at 84% 12%,transparent 0 15rpx,#ffffff66 17rpx,transparent 32rpx),linear-gradient(36deg,#008bb3,#00c6c5 46%,#00e9d4)}
.intro-name {font-size:50rpx;font-weight:700;color:white}
.intro-copy {margin-top:26rpx;font-size:28rpx;color:white}
.intro-card button {width:72%;margin:110rpx auto 0;padding:14rpx 0;border-radius:60rpx;background:#fff;color:#00a9b3;font-size:29rpx;font-weight:600}
.intro-mask .intro-close {width:54rpx;height:54rpx;margin:44rpx 0 0;border:2rpx solid #ddd;border-radius:50%;line-height:48rpx;color:white;font-size:40rpx}
