<view wx:if="{{tab === 'square' && view === 'main'}}" class="bd-square">
 <view class="bd-square-tabs"><view><button wx:for="{{['广场','我的帮搭']}}" wx:key="*this" class="{{squareTab === item ? 'bd-selected' : ''}}" data-key="squareTab" data-value="{{item}}" bindtap="squareSwitch">{{item}}</button></view><view class="bd-status-switch"><button wx:for="{{squareTab === '广场' ? ['进行','完成'] : ['发布','参与']}}" wx:key="*this" class="{{(squareTab === '广场' ? squareStatus : myStatus) === item ? 'bd-orange' : ''}}" data-key="{{squareTab === '广场' ? 'squareStatus' : 'myStatus'}}" data-value="{{item}}" bindtap="squareSwitch">{{index === 1 ? '/ ' : ''}}{{item}}</button></view></view>
 <view wx:for="{{requests}}" wx:key="id" class="bd-request-card" data-id="{{item.id}}" bindtap="requestDetail"><image class="bd-avatar" src="{{item.avatarImage || profile.avatar}}" mode="aspectFill" /><view class="bd-request-body"><view class="bd-request-person"><text class="bd-request-name">{{item.name}}</text><text class="bd-age {{item.gender === '男' ? 'bd-age-male' : ''}}">{{item.gender === '男' ? '♂' : '♀'}}{{item.age}}</text><text class="bd-season bd-season-{{item.season === '冬季' ? 'winter' : item.season === '春季' ? 'spring' : 'autumn'}}">{{item.season}}</text></view><view class="bd-budget">预算 {{item.budget}}</view><view class="bd-request-description">{{item.description}}</view><view wx:if="{{item.examples.length}}" class="bd-request-examples"><image wx:for="{{item.examples}}" wx:for-item="example" wx:key="id" src="{{example.image || example.items[0].image}}" mode="aspectFit" /></view></view><view class="bd-style-ribbon"><text>✦</text><view>{{item.style}} 〉</view></view></view>
 <view wx:if="{{!requests.length}}" class="bd-empty"><image src="{{asset}}empty-ref.jpg" mode="aspectFit" /></view>
 <view wx:if="{{!rewardDismissed}}" class="bd-square-reward"><image src="{{asset}}square-reward.png" mode="aspectFit" /><button aria-label="关闭帮搭赢红包" bindtap="dismissReward">×</button><text>帮搭赢红包</text></view>
 <button class="bd-compose" bindtap="newRequest" aria-label="发布帮搭需求"><image src="{{asset}}send-white.png" /></button>
</view>
<view wx:if="{{view === 'request'}}" class="bd-detail bd-request-detail">
 <view class="bd-profile-card" bindtap="imageProfile"><image class="bd-avatar" src="{{request.portrait || profile.avatar}}" mode="aspectFill" /><view class="bd-profile-card-copy"><view><text class="bd-black-label">适宜风格</text> {{request.style}}</view><view class="bd-facts"><text>{{request.gender}}</text><text>{{request.age}}岁</text><text>{{request.height}}cm</text><text>{{request.weight}}kg</text></view></view><text>〉</text></view>
 <view class="bd-heading">需求描述</view><view class="bd-description">{{request.description}}</view><view class="bd-budget-grid"><view><view class="bd-heading">搭配预算</view><view class="bd-info-box"><image class="bd-budget-icon" src="{{asset}}budget.png" />{{request.budget}}</view></view><view><view class="bd-heading">气温或季节</view><view class="bd-info-box">{{request.season === '夏季' ? '＞22℃' : request.season === '冬季' ? '＜10℃' : '10℃~22℃'}} {{request.season}}</view></view></view>
 <view class="bd-heading">搭配方案</view><view wx:if="{{!requestOutfits.length}}" class="bd-empty"><image src="{{asset}}empty-ref.jpg" mode="aspectFit" /></view><view wx:if="{{request.done && !requestRewardDismissed}}" class="bd-request-reward"><image src="{{asset}}gift-box.jpg" /><text>红包</text><button bindtap="dismissRequestReward" aria-label="关闭红包">×</button></view><view class="bd-grid"><view wx:for="{{requestOutfits}}" wx:key="id" class="bd-card" data-id="{{item.id}}" bindtap="openItem"><image wx:if="{{item.image}}" class="bd-topic-art" src="{{item.image}}" mode="aspectFit" /><view wx:else class="bd-collage bd-thumb"><image wx:for="{{item.items}}" wx:for-item="piece" wx:key="id" src="{{piece.image}}" style="left:{{piece.x}}%;top:{{piece.y}}%;width:{{piece.size}}%;height:{{piece.size}}%;z-index:{{piece.z}}" mode="aspectFit" /></view><text wx:if="{{item.adopted}}" class="bd-adopted">被采纳</text><view class="bd-outfit-owner"><text>{{item.author || item.title}}</text><text wx:if="{{item.price}}">¥{{item.price}}</text></view></view></view>
 <view wx:if="{{requestChoices}}" class="bd-request-choices"><button bindtap="startEditor">开始搭配</button><button bindtap="historyOutfits">历史搭配<text>（提交历史搭配无帮搭额外奖励）</text></button></view><view wx:if="{{!request.done}}" class="bd-footer"><button class="bd-black bd-full" bindtap="requestChoice">帮TA搭</button></view>
</view>
