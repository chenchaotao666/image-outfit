<view wx:if="{{!accountReady}}" class="account-status"><text>{{accountError || '正在读取账号数据…'}}</text><button wx:if="{{accountError}}" bindtap="loadAccount">重试</button></view>
<view wx:else style="--bd-status-top:{{top}}px;--bd-nav-height:{{navHeight}}px" class="bd-app bd-view-{{view}} {{tab === 'square' && view === 'main' ? 'bd-square-bg' : ''}} {{view === 'editor' ? 'bd-editor-bg' : ''}}">
 <view class="bd-header {{tab === 'mine' && view === 'main' ? 'bd-header-profile' : ''}}" style="padding-top:{{top}}px"><view class="bd-nav"><button wx:if="{{view !== 'main' || tab === 'square' || tab === 'shop'}}" class="bd-back" bindtap="back" aria-label="返回"><image src="{{asset}}back-dark.png" /></button><text>{{title}}</text></view></view>
 <include src="square.wxml" /><include src="mine.wxml" /><include src="details.wxml" /><include src="editor.wxml" /><include src="catalog.wxml" /><include src="forms.wxml" /><include src="account.wxml" /><include src="sheets.wxml" />
 <view wx:if="{{view === 'main'}}" class="bd-bottom-tabs"><button wx:for="{{['shop','products','square','mine']}}" wx:key="*this" class="{{tab === item ? 'bd-tab-active' : ''}}" data-tab="{{item}}" bindtap="setTab"><image src="{{asset}}tab-{{item}}-{{tab === item ? 'active' : 'inactive'}}.png" /><text>{{['搭购','单品','帮搭','我的'][index]}}</text></button></view>
</view>
