<view wx:if="{{(tab === 'mine' && view === 'main') || view === 'author'}}" class="bd-mine">
 <view class="bd-mine-cover"><image src="{{profile.background}}" mode="aspectFill" /><view class="bd-cover-shade"><image src="{{asset}}profile-photo-blur.jpg" mode="scaleToFill" /></view><button wx:if="{{view === 'main'}}" class="bd-more-button" bindtap="showMore"><image src="{{asset}}menu-dark.png" />更多</button><view class="bd-user-info" bindtap="tapProfileHeader"><image class="bd-user-avatar" src="{{view === 'author' ? authorImage : profile.avatar}}" mode="aspectFill" /><view><view class="bd-user-name">{{view === 'author' ? author : profile.name}} <text>⌘</text></view><text>帮搭号：{{view === 'author' ? 'PR484966' : profile.handle}}</text></view></view><button wx:if="{{view === 'author'}}" class="bd-author-follow" bindtap="toggleAuthorFollow">{{authorFollowed ? '已关注' : '关注'}}</button><view wx:if="{{profile.bio && view !== 'author'}}" class="bd-user-bio">{{profile.bio}}</view><view class="bd-user-stats"><text>{{view === 'author' ? 0 : followingCount}}关注</text><text>0粉丝</text><text>{{view === 'author' ? 4 : savedCount}}搭配</text><text>{{favoriteCount + likeCount}}赞藏</text></view></view>
 <view class="bd-mine-body"><view class="bd-mine-tabs"><button wx:for="{{['搭配','收藏','赞过']}}" wx:key="*this" data-key="mineTab" data-value="{{item}}" bindtap="mineSwitch" class="{{mineTab === item ? 'bd-selected' : ''}}">{{item}}</button></view>
 <view wx:if="{{mineTab !== '搭配'}}" class="bd-chips bd-collection-chips"><button wx:for="{{mineChips}}" wx:key="name" class="{{mineType === item.name ? 'bd-chip-on' : ''}}" data-key="mineType" data-value="{{item.name}}" bindtap="mineSwitch">{{item.name}} · {{item.count}}</button></view>
 <button wx:if="{{mineTab === '搭配'}}" class="bd-soft bd-create-topic" data-kind="专题" bindtap="newTopic">＋ 新建专题</button><button wx:if="{{mineTab === '收藏' && mineType === '分类'}}" class="bd-create-category" data-kind="分类" bindtap="newTopic">＋ 新建分类 <text>〉</text></button>
 <view wx:if="{{mineTab === '搭配' || mineType === '专题' || mineType === '分类'}}" class="bd-topics"><view wx:for="{{topics}}" wx:key="id" class="bd-topic-row" data-id="{{item.id}}" bindtap="openTopic"><view class="bd-topic-icon"></view><view><view>{{item.title}}</view><text>由 @{{profile.name}} 创建</text></view><text>共 {{item.items.length}} 个搭配</text></view></view>
 <view class="bd-grid"><view wx:for="{{view === 'author' ? authorLooks : localItems}}" wx:key="id" class="bd-card" data-id="{{item.id}}" bindtap="openItem"><view wx:if="{{item.image}}" class="bd-card-image"><image src="{{item.image}}" mode="aspectFill" /></view><view wx:else class="bd-collage bd-thumb"><image wx:for="{{item.items}}" wx:for-item="piece" wx:key="id" src="{{piece.image}}" style="left:{{piece.x}}%;top:{{piece.y}}%;width:{{piece.size}}%;height:{{piece.size}}%;z-index:{{piece.z}}" mode="aspectFit" /></view><button class="bd-mine-heart" data-id="{{item.id}}" catchtap="toggleLike" aria-label="喜欢搭配"><image src="{{asset}}heart-{{item.liked ? 'filled' : 'orange'}}.png" /></button><view wx:if="{{mineTab === '搭配'}}" class="bd-card-title">{{item.title}}</view></view></view>
 <view wx:if="{{!localItems.length && !topics.length && !(mineTab === '收藏' && mineType === '分类') && view !== 'author'}}" class="bd-empty"><image src="{{asset}}empty-ref.jpg" mode="aspectFit" /></view>
 </view>
</view>
