<view wx:if="{{sheet}}" class="bd-mask bd-mask-{{sheet}}" bindtap="closeSheet"><view class="bd-sheet bd-sheet-{{sheet}} {{sheet === 'advice' ? 'bd-advice-sheet' : ''}} {{sheet === 'more' ? 'bd-menu-sheet' : ''}}" catchtap="noop">
 <view class="bd-sheet-handle"></view><button wx:if="{{sheet === 'templates' || sheet === 'posterTemplates'}}" class="bd-sheet-close" bindtap="closeSheet" aria-label="关闭弹窗">×</button>
 <view wx:if="{{sheet === 'filter'}}"><view class="bd-sheet-heading">{{tab === 'shop' && !selectMode ? '搭配' : '单品'}}筛选</view><scroll-view scroll-y class="bd-filter-scroll">
  <view class="bd-filter-label">性别</view><view class="bd-radio-row"><button wx:for="{{['男','女']}}" wx:key="*this" class="{{draftFilters.gender === item ? 'bd-radio-selected' : ''}}" data-key="gender" data-value="{{item}}" bindtap="filter"><view></view>{{item}}</button></view>
  <view wx:if="{{tab !== 'shop' || selectMode}}"><view class="bd-filter-label">包含色系</view><view class="bd-color-grid"><button wx:for="{{colors}}" wx:key="name" style="background:{{item.hex}}" class="{{draftFilters.color === item.name ? 'bd-color-on' : ''}}" data-key="color" data-value="{{item.name}}" bindtap="filter" aria-label="{{item.name}}"><image wx:if="{{draftFilters.color === item.name}}" src="{{asset}}check-{{item.name === '白色' ? 'dark' : 'white'}}.png" /></button></view></view>
  <view class="bd-filter-label">{{tab === 'shop' && !selectMode ? '整套价格区间' : '价格区间'}}</view><view class="bd-price-range"><input placeholder="最低价" type="digit" data-key="min" data-field="filter-min" value="{{draftFilters.min}}" bindinput="filterInput" /><text>—</text><input placeholder="最高价" type="digit" data-key="max" data-field="filter-max" value="{{draftFilters.max}}" bindinput="filterInput" /></view><view class="bd-chips"><button wx:for="{{tab === 'shop' && !selectMode ? ['0~299','300~599','600~999','1000~9999'] : ['0~99','100~199','200~299','300~399']}}" wx:key="*this" class="{{draftFilters.price === item ? 'bd-chip-on' : ''}}" data-key="price" data-value="{{item}}" bindtap="filter">{{item}}</button></view>
  <view wx:if="{{tab === 'shop' && !selectMode}}"><view class="bd-filter-label">适宜场合</view><view class="bd-chips"><button wx:for="{{occasions}}" wx:key="*this" class="{{draftFilters.occasion === item ? 'bd-chip-on' : ''}}" data-key="occasion" data-value="{{item}}" bindtap="filter">{{item}}</button></view><view class="bd-filter-label">适合季节</view><view class="bd-chips"><button wx:for="{{seasons}}" wx:key="*this" class="{{draftFilters.season === item ? 'bd-chip-on' : ''}}" data-key="season" data-value="{{item}}" bindtap="filter">{{['春','夏','秋','冬'][index]}}</button></view><view class="bd-filter-label">适宜人群类型 <text>男女14种形象风格类型说明 〉</text></view><view class="bd-chips"><button wx:for="{{styleTypes}}" wx:key="*this" class="{{draftFilters.type === item ? 'bd-chip-on' : ''}}" data-key="type" data-value="{{item}}" bindtap="filter">{{item}}</button></view><view class="bd-filter-label">偏好搭配风格</view><view class="bd-chips"><button wx:for="{{filterStyles}}" wx:key="*this" class="{{draftFilters.style === item ? 'bd-chip-on' : ''}}" data-key="style" data-value="{{item}}" bindtap="filter">{{item}}</button></view></view>
  <view wx:else><view class="bd-filter-label">平台</view><view class="bd-chips"><button wx:for="{{['京东','唯品会','淘宝']}}" wx:key="*this" class="{{draftFilters.platform === item ? 'bd-chip-on' : ''}}" data-key="platform" data-value="{{item}}" bindtap="filter">{{item}}</button></view></view>
 </scroll-view><button class="bd-black bd-full" bindtap="applyFilter">确定</button></view>
 <view wx:if="{{sheet === 'templates'}}"><view class="bd-sheet-heading">搭配模板</view><view class="bd-template-grid"><button wx:for="{{templates}}" wx:key="*this" class="bd-template {{layout === item ? 'bd-template-on' : ''}}" data-value="{{item}}" bindtap="useTemplate" aria-label="搭配模板{{index + 1}}"><image src="{{asset}}template-{{item}}.jpg" mode="aspectFit" /></button></view></view>
 <view wx:if="{{sheet === 'advice'}}"><swiper current="{{adviceIndex}}" bindchange="advicePage" class="bd-advice-swiper"><swiper-item wx:for="{{adviceTitles}}" wx:key="*this"><image class="bd-advice-art" src="{{asset}}advice-{{index}}.jpg" mode="aspectFill" /><view class="bd-advice-copy"><view class="bd-sheet-heading">{{item}}</view><view class="bd-description">{{adviceTexts[index]}}</view></view></swiper-item></swiper><view class="bd-dots"><button wx:for="{{adviceTitles}}" wx:key="*this" data-index="{{index}}" bindtap="advicePage" class="{{adviceIndex === index ? 'bd-dot-active' : ''}}" aria-label="建议{{index+1}}"></button></view><button class="bd-advice-close" bindtap="closeSheet" aria-label="关闭建议">×</button></view>
 <view wx:if="{{sheet === 'editorRequest'}}"><view class="bd-sheet-heading">帮搭需求</view><view class="bd-demand-block"><view class="bd-heading">搭配需求说明</view><text>{{requestId ? request.description : '自由搭配'}}</text></view><view class="bd-demand-grid"><view class="bd-demand-block"><view class="bd-heading">全套搭配预算</view><text>{{requestId ? request.budget : '不限'}}</text></view><view class="bd-demand-block"><view class="bd-heading">穿着季节</view><text>{{requestId ? request.season : '不限'}}</text></view><view class="bd-demand-block"><view class="bd-heading">穿着场合</view><text>{{request.occasion || '都市休闲'}}</text></view><view class="bd-demand-block"><view class="bd-heading">用户职业</view><text>{{request.stage || '职场'}} {{request.occupation ? '（' + request.occupation + '）' : ''}}</text></view></view></view>
 <view wx:if="{{sheet === 'imageProfile'}}"><view class="bd-sheet-heading">形象档案 <text>ⓘ 男女风格类型</text></view><view class="bd-profile-card"><image class="bd-avatar" src="{{requestId || view === 'request' ? request.portrait || profile.avatar : profile.avatar}}" mode="aspectFill" /><view class="bd-profile-card-copy"><view><text class="bd-black-label">适宜风格</text> {{requestId || view === 'request' ? request.style : profile.style}}</view><view class="bd-facts"><text>{{requestId || view === 'request' ? request.gender : profile.gender}}</text><text>{{requestId || view === 'request' ? request.age : profile.age}}岁</text><text>{{requestId || view === 'request' ? request.height : profile.height}}cm</text><text>{{requestId || view === 'request' ? request.weight : profile.weight}}kg</text></view></view></view><view class="bd-traits"><view wx:for="{{profileTraits}}" wx:key="*this"><image class="bd-trait-image" src="{{asset}}trait-{{index}}.png" />{{item}}</view></view><view class="bd-style-profile"><view><text>现在所处阶段</text><text>{{request.stage || '职场'}} {{request.occupation ? '（' + request.occupation + '）' : ''}}</text></view><view>喜欢的风格</view><view class="bd-style-avatars"><view wx:for="{{profileStyles}}" wx:key="name"><image src="{{item.image}}" mode="aspectFill" /><text>{{item.name}}</text></view></view></view></view>
 <view wx:if="{{sheet === 'more'}}" class="bd-side-menu"><button wx:for="{{menuItems}}" wx:key="view" data-view="{{item.view}}" bindtap="settings" class="bd-menu-item bd-menu-item-{{index}}"><image src="{{asset}}menu-{{index}}.png" />{{item.title}}</button></view>
 <view wx:if="{{sheet === 'comments'}}"><view class="bd-sheet-heading">搭配讨论</view><view class="bd-comments-scroll"><view wx:for="{{comments}}" wx:key="id" class="bd-comment"><image src="{{profile.avatar}}" /><view><text>{{item.author}}</text><view>{{item.text}}</view><text wx:if="{{item.date}}" class="bd-comment-date">{{item.date}}</text></view><image class="bd-comment-like" src="{{asset}}heart-muted.png" /></view></view><view class="bd-comment-input"><input value="{{comment}}" data-key="comment" data-field="comment" bindinput="textInput" placeholder="说点儿什么吧~" maxlength="300" /><button wx:if="{{comment}}" bindtap="addComment">发送</button></view></view>
 <view wx:if="{{sheet === 'share'}}"><view class="bd-sheet-heading">分享方式</view><view class="bd-share-options"><button bindtap="savePlain"><image src="{{asset}}down-orange.png" /><text>保存纯图</text></button><button bindtap="showPoster"><image src="{{asset}}picture-orange.png" /><text>OOTD海报</text></button><button wx:if="{{view !== 'product'}}" data-custom="1" bindtap="showPoster"><image src="{{asset}}star-orange.png" /><text>定制海报</text></button><button open-type="share" bindtap="shareApp"><image src="{{asset}}share-orange.png" /><text>分享好友</text></button></view></view>
 <view wx:if="{{sheet === 'history'}}"><view class="bd-sheet-heading">历史搭配</view><view wx:if="{{!historyChoices.length}}" class="bd-empty"><image src="{{asset}}empty-ref.jpg" mode="aspectFit" /></view><view class="bd-history-list"><button wx:for="{{historyChoices}}" wx:key="id" data-id="{{item.id}}" bindtap="historySelect">{{item.title}} <text>{{item.checked ? '✓' : '○'}}</text></button></view><button class="bd-black bd-full" bindtap="historyConfirm">确定</button></view>
 <view wx:if="{{sheet === 'city'}}"><view class="bd-city-heading"><button bindtap="closeSheet">取消</button><button bindtap="saveCity">确定</button></view><picker-view class="bd-city-picker" value="{{cityIndexes}}" bindchange="cityPickerChange" indicator-style="height:80rpx" mask-style="background:linear-gradient(white,transparent 40%,transparent 60%,white)"><picker-view-column><view wx:for="{{cityProvinces}}" wx:key="*this">{{item}}</view></picker-view-column><picker-view-column><view wx:for="{{cityAreas}}" wx:key="*this">{{item}}</view></picker-view-column><picker-view-column><view>{{cityDistrict}}</view></picker-view-column></picker-view><input value="{{cityDraft}}" bindinput="cityChange" data-field="city" placeholder="输入所在城市" /></view>
 <view wx:if="{{sheet === 'phoneConfirm'}}"><view class="bd-heading">更换绑定的手机号？</view><view class="bd-form-hint">当前尚未绑定手机号</view><button class="bd-black bd-full" bindtap="phonePage">更换</button><button class="bd-cancel" bindtap="closeSheet">取消</button></view>
 <view wx:if="{{sheet === 'service'}}"><view class="bd-sheet-heading">{{serviceTitle}}</view><view class="bd-description">{{serviceTitle === '搭配认证' ? '当前为本地体验，认证服务尚未开放。' : serviceTitle === '我的钱包' ? '当前余额 ¥0.00。尚未接入交易与提现。' : '当前为本地体验，此服务尚未接入。'}}</view><button class="bd-black bd-full" bindtap="closeSheet">知道了</button></view>
 <view wx:if="{{sheet === 'posterTemplates'}}"><view class="bd-sheet-heading">海报模板 <button data-index="0" bindtap="posterTemplate">取消模板</button></view><view class="bd-poster-template-grid"><button wx:for="{{[2,3,4,5,6,1]}}" wx:key="*this" class="bd-poster-template bd-poster-template-{{item}}" data-index="{{item}}" bindtap="posterTemplate"><image wx:if="{{index < 4}}" src="{{asset}}poster-template-{{index}}.jpg" mode="aspectFill" /><text wx:else>TOTAL LOOK</text></button></view></view>
 <view wx:if="{{sheet === 'topicPick'}}"><view class="bd-sheet-heading">选择搭配</view><view class="bd-topic-pick"><button wx:for="{{topicCandidates}}" wx:key="id" class="bd-detail-list {{item.checked ? 'bd-orange' : ''}}" data-id="{{item.id}}" bindtap="topicSelect"><text>{{item.title}}</text><text>{{item.checked ? '✓ 已选' : '＋'}}</text></button></view><button class="bd-black bd-full" bindtap="closeSheet">确定</button></view>
</view></view>