<view wx:if="{{view === 'account'}}" class="bd-account"><view class="bd-account-title">账号信息</view><view class="bd-account-subtitle">AI检测、My衣橱管家、帮搭账号通用</view><button class="bd-setting-row" data-action="phone" bindtap="accountAction"><text>手机号</text><text class="bd-setting-value">未绑定</text><text>〉</text></button><button class="bd-setting-row" data-action="wechat" bindtap="accountAction"><text>微信账号</text><text class="bd-setting-value">未绑定</text><text>〉</text></button><button class="bd-setting-row" data-action="apple" bindtap="accountAction"><text>苹果账号</text><text class="bd-setting-value">未绑定</text><text>〉</text></button><button class="bd-setting-row" data-action="verify" bindtap="accountAction"><text>官方认证</text><text class="bd-setting-value">未认证</text><text>〉</text></button><button class="bd-setting-row" data-action="delete" bindtap="accountAction"><text>注销账号</text><text class="bd-setting-value"></text><text>〉</text></button></view>
<view wx:if="{{view === 'phone'}}" class="bd-account bd-phone"><view class="bd-account-title">手机号验证</view><view class="bd-phone-input"><input type="number" maxlength="11" value="{{phoneNumber}}" data-key="phoneNumber" data-field="phone" bindinput="textInput" placeholder="请输入手机号" /></view><view class="bd-phone-input"><input type="number" maxlength="6" value="{{phoneCode}}" data-key="phoneCode" data-field="code" bindinput="textInput" placeholder="请输入验证码" /><button bindtap="sendCode">发送</button></view><button class="bd-black bd-full" disabled="{{phoneNumber.length !== 11 || !phoneCode}}" bindtap="sendCode">确定</button></view>
<view wx:if="{{view === 'deleteAccount'}}" class="bd-account bd-phone bd-account-delete">
 <view class="bd-account-title">真的要注销吗？</view>
 <view class="bd-description">注销账号后，相关账号资料与记录将无法恢复。</view>
 <view class="bd-delete-prompt">请在下面输入“我要注销”点“确认注销”即可</view>
 <view class="bd-phone-input"><input placeholder="输入我要注销" value="{{deletePhrase}}" data-key="deletePhrase" bindinput="textInput" /></view>
 <button class="bd-black bd-full" bindtap="deleteAccount">确认注销</button>
</view>
