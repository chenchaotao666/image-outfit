<view wx:if="{{selectMode}}" class="bd-library-backdrop" bindtap="confirmProducts"></view>
<view wx:if="{{(view === 'main' && (tab === 'shop' || tab === 'products')) || selectMode}}" class="bd-catalog {{selectMode ? 'bd-library' : ''}}">
 <view wx:if="{{selectMode}}" class="bd-sheet-handle"></view>
 <view class="bd-search-row"><view class="bd-search"><image src="{{asset}}search-dark.png" /><input value="{{query}}" bindinput="search" confirm-type="search" aria-label="搜索单品或搭配" data-field="bangda-search" /><button wx:if="{{query}}" bindtap="clearSearch" aria-label="清空搜索">×</button></view><button class="bd-filter" bindtap="openFilter" aria-label="筛选"><image src="{{asset}}filter-white.png" /><text wx:if="{{filterCount}}" class="bd-badge">{{filterCount}}</text></button></view>
 <view wx:if="{{tab === 'products' || selectMode}}" class="bd-categories"><button wx:for="{{categories}}" wx:key="*this" data-value="{{selectMode && index === 5 ? '配饰' : item}}" bindtap="chooseCategory" class="{{category === item ? 'bd-orange' : ''}}"><image wx:if="{{index < 5}}" src="{{categoryGroups[0].sections[0].items[[1,3,0,2,4][index]].image}}" mode="aspectFit" /><image wx:if="{{selectMode && index === 5}}" src="{{categoryGroups[0].sections[0].items[5].image}}" mode="aspectFit" /><view wx:if="{{!selectMode && index === 5}}" class="bd-more-circle">more</view><text>{{selectMode && index === 5 ? '配饰' : item}}</text></button></view>
 <view wx:else class="bd-sort"><button wx:for="{{sorts}}" wx:key="*this" class="{{sort === item ? 'bd-selected' : ''}}" data-value="{{item}}" bindtap="sort">{{item}}<view wx:if="{{item === '价格'}}" class="bd-sort-arrows"><text>⌃</text><text>⌄</text></view></button></view>
 <view class="bd-grid"><view wx:for="{{visible}}" wx:key="id" class="bd-card">
  <view class="bd-card-image" data-id="{{item.id}}" bindtap="openItem"><image src="{{item.image}}" mode="aspectFill" /></view>
  <view class="bd-card-title" data-id="{{item.id}}" bindtap="openItem"><text wx:if="{{item.brand}}" class="bd-platform">{{item.platform}}</text>{{item.brand ? item.brand + ' ' : ''}}{{item.title}}</view>
  <view wx:if="{{item.brand}}"><view class="bd-price">¥{{item.priceText}}<text wx:if="{{!selectMode}}" class="bd-original">¥{{item.originalText}}</text></view><view wx:if="{{!selectMode}}" class="bd-rebate">返：¥ {{item.rebate}}</view><view class="bd-card-actions"><button data-id="{{item.id}}" bindtap="toggleFavorite" aria-label="收藏单品"><image src="{{asset}}heart-{{item.favorite ? 'orange' : 'muted'}}.png" /><text wx:if="{{selectMode}}">{{item.favorite ? 1 : 0}}</text></button><button class="bd-add {{item.selected ? 'bd-added' : ''}}" data-id="{{item.id}}" bindtap="addProduct">{{item.selected ? '已选' : '+搭'}}</button></view></view>
  <view wx:else class="bd-author-row"><image class="bd-tiny-avatar" src="{{item.authorAvatar}}" mode="aspectFill" /><text>{{item.author}}</text><button data-id="{{item.id}}" bindtap="toggleLike" aria-label="喜欢搭配"><image src="{{asset}}heart-{{item.liked ? 'orange' : 'muted'}}.png" />{{item.likes + (item.liked ? 1 : 0) || ''}}</button></view>
 </view></view>
 <view wx:if="{{!visible.length}}" class="bd-empty"><image src="{{asset}}empty-ref.jpg" mode="aspectFit" /><button class="bd-soft" bindtap="clearSearch">清除筛选</button></view>
 <button wx:if="{{tab === 'products' && !selectMode}}" class="bd-support" bindtap="support" aria-label="联系客服"><image src="{{asset}}support.jpg" /></button>
 <view wx:if="{{selected.length && tab === 'products' && !selectMode && !trayCollapsed}}" class="bd-selection-tray"><view class="bd-tray-title"><text>已选{{selected.length}}件单品</text><button bindtap="startEditor">下一步 〉</button><button bindtap="toggleTray" aria-label="收起已选单品">⌄</button></view><view class="bd-mini-strip"><view wx:for="{{selected}}" wx:key="id"><image src="{{item.image}}" mode="aspectFit" /><button data-id="{{item.id}}" catchtap="removeCanvas">×</button></view></view></view>
 <button wx:if="{{selected.length && tab === 'products' && !selectMode && trayCollapsed}}" class="bd-tray-count" bindtap="toggleTray">{{selected.length}}</button>
 <view wx:if="{{selectMode}}" class="bd-footer bd-library-footer"><button class="bd-icon-button {{!libraryFavorites ? 'bd-selected' : ''}}" bindtap="selectProducts"><image src="{{asset}}shirt-dark.png" /><text>单品库</text></button><button class="bd-icon-button {{libraryFavorites ? 'bd-selected' : ''}}" data-favorite="1" bindtap="selectProducts"><image src="{{asset}}heart-dark.png" /><text>收藏夹</text></button><button class="bd-black" bindtap="confirmProducts">确定</button></view>
</view>
<view wx:if="{{view === 'categories'}}" class="bd-category-shell"><view class="bd-search"><image src="{{asset}}search-dark.png" /><input bindinput="categorySearch" value="{{categoryQuery}}" data-field="category-search" aria-label="搜索分类" /></view><view class="bd-category-page"><view class="bd-category-rail"><button wx:for="{{categoryGroups}}" wx:key="name" class="{{categoryGroup === item.name ? 'bd-category-on' : ''}}" data-value="{{item.name}}" bindtap="categoryGroup">{{item.name}}</button></view><view class="bd-category-content"><view wx:for="{{categorySections}}" wx:for-item="section" wx:key="title"><view class="bd-heading">{{section.title}}</view><view class="bd-category-grid"><button wx:for="{{section.items}}" wx:key="name" data-value="{{item.name}}" bindtap="categoryOption"><image src="{{item.image}}" mode="aspectFit" /><text>{{item.name}}</text></button></view></view></view></view></view>
