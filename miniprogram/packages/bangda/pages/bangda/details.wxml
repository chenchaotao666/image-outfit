<view wx:if="{{view === 'product'}}" class="bd-product-detail">
 <view class="bd-product-gallery"><swiper current="{{galleryIndex}}" bindchange="galleryChange"><swiper-item wx:for="{{detail.gallery}}" wx:key="*this"><image src="{{item}}" mode="aspectFit" /></swiper-item></swiper><view class="bd-gallery-tabs"><button class="{{galleryIndex === 0 ? 'bd-gallery-on' : ''}}" data-index="0" bindtap="galleryTab">商品</button><button wx:if="{{detail.gallery.length > 1}}" class="{{galleryIndex > 0 ? 'bd-gallery-on' : ''}}" data-index="1" bindtap="galleryTab">穿搭</button></view><text class="bd-gallery-count">{{galleryIndex + 1}}/{{detail.gallery.length}}</text></view>
 <view class="bd-product-copy"><view class="bd-detail-price">¥{{detail.priceText}} <text>¥{{detail.originalText}}</text><text class="bd-rebate">{{detail.likes || 0}}人喜欢</text></view><view class="bd-heading"><text class="bd-platform">{{detail.platform}}</text> {{detail.brand}} {{detail.title}}</view><view class="bd-price-note">* 价格仅供参考实际以销售平台为准！</view><button class="bd-product-add" data-id="{{detail.id}}" bindtap="addProduct">{{detailSelected ? '已加入搭配' : '+ 加入搭配'}}</button></view><view class="bd-product-divider">商品详情</view><view wx:if="{{detail.detailStrips.length}}" class="bd-detail-strips"><image wx:for="{{detail.detailStrips}}" wx:key="*this" src="{{item}}" mode="widthFix" /></view><view wx:else class="bd-detail-strips"><image src="{{detail.hero}}" mode="widthFix" /><view class="bd-brand-panel"><text>{{detail.brand}}</text><view>{{detail.title}}</view></view></view>
 <view class="bd-footer bd-product-footer"><button class="bd-icon-button" aria-label="收藏" bindtap="toggleFavorite"><image src="{{asset}}star-{{favorite ? 'orange' : 'dark'}}.png" /><text>{{favorite ? 1 : 0}}</text></button><button class="bd-icon-button" aria-label="分享" bindtap="share"><image src="{{asset}}share-dark.png" /></button><button class="bd-black" bindtap="buy">去购买</button></view>
</view>
<view wx:if="{{view === 'look'}}" class="bd-look-detail"><image wx:if="{{detail.image}}" class="bd-look-hero" src="{{detail.image}}" mode="aspectFit" /><view wx:else class="bd-collage bd-look-hero"><image wx:for="{{detail.items}}" wx:key="id" src="{{item.editorImage || item.image}}" mode="aspectFit" style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.size}}%;height:{{item.size}}%;z-index:{{item.z}}" /></view><view class="bd-look-copy"><view class="bd-heading">{{detail.title}}</view><view class="bd-pieces-label">搭配单品</view><view class="bd-look-thumbs"><image wx:for="{{detailProducts}}" wx:key="id" src="{{item.image}}" mode="aspectFit" data-id="{{item.id}}" bindtap="openItem" /></view><view class="bd-look-meta"><text>{{detailProducts.length || detail.items.length || 0}}件单品共计 ￥{{detail.priceText || detail.price}}</text><text>搭配ID：{{detail.displayId || detail.id}}</text></view><view class="bd-reason"><view>搭配说明</view><text>{{detail.description || '以舒适的比例和配色，找到适合自己的日常风格。'}}</text></view><button class="bd-detail-list bd-author-heading" bindtap="showAuthor"><text>搭配分享者</text><text>〉</text></button><button class="bd-look-author" bindtap="showAuthor"><image src="{{detail.authorAvatar || profile.avatar}}" mode="aspectFill" /><view><text>{{detail.author}}</text><view>暂无简介</view></view></button><button class="bd-detail-list" bindtap="showComments"><text>搭配讨论（{{comments.length}}）</text><text>〉</text></button><view wx:for="{{comments}}" wx:key="id" class="bd-comment"><image src="{{profile.avatar}}" /><view><text>{{item.author}}</text><view>{{item.text}}</view><text wx:if="{{item.date}}" class="bd-comment-date">{{item.date}}</text></view></view></view><view wx:if="{{detailProducts.length}}" class="bd-content-label">搭配内容</view><view wx:for="{{detailProducts}}" wx:key="id" class="bd-look-product"><text class="bd-piece-number">单品{{['一','二','三','四','五','六','七','八'][index]}}</text><swiper data-id="{{item.id}}" current="{{pieceSlides[item.id] || 0}}" bindchange="pieceGalleryChange" indicator-dots="{{item.gallery.length > 1}}"><swiper-item wx:for="{{item.gallery}}" wx:for-item="photo" wx:key="*this"><image class="bd-look-slide" src="{{photo}}" mode="aspectFit" /></swiper-item></swiper><view class="bd-look-product-copy" data-id="{{item.id}}" bindtap="openItem"><text class="bd-platform">{{item.platform}}</text><text class="bd-look-product-title">{{item.title}}</text><text class="bd-look-product-price">{{item.priceText}}</text></view></view><button wx:if="{{detail.items}}" class="bd-delete-link" bindtap="deleteOutfit">删除搭配</button><view class="bd-footer bd-look-footer"><button bindtap="toggleFavorite"><image src="{{asset}}star-{{favorite ? 'orange' : 'dark'}}.png" />{{(detail.saves || 0) + (favorite ? 1 : 0)}}</button><button bindtap="share"><image src="{{asset}}share-dark.png" /></button></view></view>
<view wx:if="{{view === 'topic'}}" class="bd-topic-detail"><view class="bd-heading">{{topic.title}}</view><view class="bd-topic-owner"><image src="{{profile.avatar}}" /><text>{{profile.name}}</text></view><view class="bd-description">{{topic.description}}</view><view class="bd-topic-toolbar"><text>共 {{topicItems.length}} 套搭配</text><button bindtap="editTopic">管理</button><text>发布时间 ﹀</text></view><view class="bd-grid"><view wx:for="{{topicItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openItem"><image wx:if="{{item.image}}" class="bd-topic-art" src="{{item.image}}" mode="aspectFit" /><view wx:else class="bd-collage bd-thumb"><image wx:for="{{item.items}}" wx:for-item="piece" wx:key="id" src="{{piece.editorImage || piece.image}}" mode="aspectFit" style="left:{{piece.x}}%;top:{{piece.y}}%;width:{{piece.size}}%;height:{{piece.size}}%;z-index:{{piece.z}}" /></view><text>{{item.title}}</text></view></view><view wx:if="{{!topicItems.length}}" class="bd-empty"><image src="{{asset}}empty-ref.jpg" mode="aspectFit" /></view></view>
<view wx:if="{{view === 'poster' || view === 'customPoster'}}" class="bd-poster-page {{view === 'customPoster' ? 'bd-custom-poster' : ''}}"><view class="bd-poster bd-poster-{{posterStyle}} {{detail.posterCutout && view === 'poster' ? 'bd-tall-product-poster' : ''}}" style="transform:scale({{posterScale}})"><view wx:if="{{posterTitleEnabled}}" class="bd-poster-title">TOTAL LOOK</view><text wx:if="{{view === 'poster'}}" class="bd-poster-stamp">帮搭</text><image wx:if="{{detail.image}}" class="bd-poster-art" src="{{view === 'poster' && detail.posterCutout ? detail.posterCutout : detail.image}}" mode="aspectFit" /><view wx:else class="bd-collage bd-poster-collage"><image wx:for="{{detail.items}}" wx:key="id" src="{{item.editorImage || item.image}}" mode="aspectFit" style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.size}}%;height:{{item.size}}%;z-index:{{item.z}}" /></view><view wx:if="{{posterPrice}}" class="bd-price">¥{{detail.priceText || detail.price}}</view><view wx:if="{{posterAttributes}}" class="bd-poster-attributes">{{detail.style || detail.category}} · {{detail.season}}</view><view class="bd-poster-extra {{posterTool === '文字' && posterExtra ? 'bd-extra-selected' : ''}}">{{posterExtra}}</view><view wx:if="{{view === 'poster'}}" class="bd-poster-sign"><image src="{{profile.avatar}}" /><view><view>{{profile.name}}</view><text>{{posterText}}</text></view><text class="bd-poster-mark">帮搭</text></view></view><button wx:if="{{view === 'poster'}}" class="bd-poster-save" bindtap="savePoster">保存海报</button><view wx:if="{{view === 'customPoster'}}"><view class="bd-poster-zoom"><button data-step="-0.1" bindtap="posterZoom" aria-label="缩小海报"><image src="{{asset}}poster-minus.png" /></button><text>小红书⌄</text><button data-step="0.1" bindtap="posterZoom" aria-label="放大海报"><image src="{{asset}}poster-plus.png" /></button></view><view wx:if="{{posterTool === '文字'}}" class="bd-poster-text-edit"><input value="{{posterInput}}" data-key="posterInput" data-field="poster-input" bindinput="textInput" placeholder="输入文字" maxlength="40" /><button bindtap="posterAddText">添加</button></view><button class="bd-custom-save" bindtap="savePoster">保存</button><view class="bd-poster-toolbar"><button wx:for="{{['标题','价格','属性','模板','文字']}}" wx:key="*this" data-value="{{item}}" bindtap="posterTool"><view><image src="{{asset}}poster-tool-{{index}}.png" /></view>{{item}}</button></view></view></view>
<view wx:if="{{posterGenerating}}" class="bd-generating" role="status"><view class="bd-spinner"></view><text>海报生成中…</text></view>
<canvas wx:if="{{view === 'poster' || view === 'customPoster' || plainExport}}" canvas-id="bangda-poster" class="bd-export-canvas" style="width:600px;height:850px"></canvas>
