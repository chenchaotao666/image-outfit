<view wx:if="{{view === 'editor' || view === 'publish'}}" class="bd-editor">
 <view wx:if="{{view === 'editor'}}" class="bd-editor-top"><button class="bd-pill-black" bindtap="showTemplates">搭配模板</button><button wx:if="{{requestId && canvasItems.length}}" class="bd-advice-button" bindtap="showAdvice" aria-label="搭配建议">⌣</button><view></view><button wx:if="{{requestId}}" class="bd-pill" bindtap="editorRequest">用户需求</button><button wx:if="{{requestId}}" class="bd-pill" bindtap="imageProfile">用户形象</button><button wx:else class="bd-pill" bindtap="showAdvice">更多 ⋮</button></view>
 <view class="bd-canvas-wrap"><view class="bd-canvas bd-collage"><view wx:if="{{showTemplate && view === 'editor'}}" class="bd-template-overlay"><view wx:for="{{templateSlots}}" wx:key="index" style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.size}}%;height:{{item.size}}%"><image src="{{asset}}shirt-orange.png" /></view></view><view wx:for="{{canvasItems}}" wx:key="id" class="bd-canvas-piece {{activeItem === item.id && view === 'editor' ? 'bd-piece-active' : ''}}" style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.size}}%;height:{{item.size}}%;z-index:{{item.z}}" data-id="{{item.id}}" bindtap="selectCanvas" bindtouchstart="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd"><image src="{{item.editorImage || item.image}}" mode="aspectFit" /><button wx:if="{{activeItem === item.id && view === 'editor'}}" data-id="{{item.id}}" catchtap="removeCanvas" class="bd-piece-remove" aria-label="移除单品">×</button><view wx:if="{{activeItem === item.id && view === 'editor'}}" class="bd-piece-resize" data-id="{{item.id}}" catchtouchstart="resizeStart" catchtouchmove="resizeMove" catchtouchend="resizeEnd">⌑</view></view></view>
 <view wx:if="{{view === 'editor'}}" class="bd-editor-tools"><button wx:for="{{['down','up','zoom','minus']}}" wx:key="*this" data-action="{{item}}" bindtap="transform"><image src="{{asset}}{{item}}-orange.png" /><text>{{['置底','置顶','放大','缩小'][index]}}</text></button></view></view>
 <view wx:if="{{view === 'editor'}}" class="bd-editor-strip"><view class="bd-piece-list"><view wx:for="{{selected}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCanvas"><image src="{{item.image}}" mode="aspectFit" /><button wx:if="{{canvasItems.length}}" class="bd-small-remove" data-id="{{item.id}}" catchtap="removeCanvas" aria-label="取消选择">×</button></view></view><button class="bd-editor-support" bindtap="support"><image src="{{asset}}support.jpg" /></button></view>
 <view wx:if="{{view === 'publish'}}" class="bd-publish-form"><view class="bd-price">¥{{total}}</view><view class="bd-heading">搭配名称</view><textarea value="{{outfitTitle}}" data-key="outfitTitle" data-field="outfitTitle" bindinput="textInput" placeholder="我的搭配" maxlength="20"></textarea><view class="bd-heading">搭配说明</view><textarea value="{{note}}" data-key="note" data-field="note" bindinput="textInput" placeholder="我的搭配" maxlength="500"></textarea></view>
 <view class="bd-footer"><button wx:if="{{view === 'editor'}}" class="bd-icon-button" bindtap="selectProducts"><image src="{{asset}}shirt-dark.png" /><text>单品库</text></button><button wx:if="{{view === 'editor'}}" class="bd-icon-button" data-favorite="1" bindtap="selectProducts"><image src="{{asset}}heart-dark.png" /><text>收藏夹</text></button><button wx:if="{{view === 'editor'}}" class="bd-black" bindtap="nextOutfit">下一步</button><button wx:else class="bd-black bd-full" bindtap="publish">提交</button></view>
</view>
