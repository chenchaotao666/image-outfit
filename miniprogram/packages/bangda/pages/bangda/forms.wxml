<view wx:if="{{view === 'requestForm'}}" class="bd-form"><view class="bd-heading">你想要怎样的穿搭？</view><text class="bd-form-hint">说说你的场景、喜好和穿搭困扰</text><textarea value="{{form.description}}" data-key="description" bindinput="field" maxlength="300" placeholder="例如：日常通勤，希望简约知性、舒适大方…" data-field="description"></textarea><view class="bd-heading">搭配预算</view><view class="bd-chips"><button wx:for="{{['0~1000','1000~2500','2500~5000']}}" wx:key="*this" data-key="budget" data-value="{{item}}" bindtap="formChoice" class="{{form.budget === item ? 'bd-chip-on' : ''}}">¥ {{item}}</button></view><view class="bd-heading">气温或季节</view><view class="bd-chips"><button wx:for="{{seasons}}" wx:key="*this" data-key="season" data-value="{{item}}" bindtap="formChoice" class="{{form.season === item ? 'bd-chip-on' : ''}}">{{item}}</button></view><view class="bd-heading">期待的风格</view><view class="bd-chips"><button wx:for="{{styles}}" wx:key="*this" data-key="style" data-value="{{item}}" bindtap="formChoice" class="{{form.style === item ? 'bd-chip-on' : ''}}">{{item}}</button></view><view class="bd-form-hint">这条需求会保存在「我的帮搭」，仅当前账号可见。</view><view class="bd-footer"><button class="bd-black bd-full" bindtap="submitRequest">保存需求</button></view></view>

<view wx:if="{{view === 'profile'}}" class="bd-profile-settings">
 <button class="bd-setting-row bd-avatar-setting" data-key="avatar" bindtap="chooseProfileImage"><text>头像</text><image class="bd-setting-avatar" src="{{profile.avatar}}" mode="aspectFill" /><text>〉</text></button>
 <button wx:for="{{['name','handle','bio','gender']}}" wx:key="*this" class="bd-setting-row" data-key="{{item}}" bindtap="profileField"><text>{{['昵称','帮搭号','简介','性别'][index]}}</text><text class="bd-setting-value">{{profile[item] || '暂无简介'}}</text><text>〉</text></button>
 <button class="bd-setting-row" bindtap="profileCity"><text>城市</text><text class="bd-setting-value">{{profile.city || '暂无'}}</text><text>〉</text></button>
 <button class="bd-setting-row bd-background-row" data-key="background" bindtap="chooseProfileImage"><text>背景图</text><image src="{{profile.background}}" mode="aspectFill" /><text>〉</text></button>
</view>
<view wx:if="{{view === 'profileField'}}" class="bd-field-page">
 <view wx:if="{{editKey === 'gender'}}" class="bd-gender-choices"><button wx:for="{{['女','男']}}" wx:key="*this" class="{{editValue === item ? 'bd-gender-selected' : ''}}" data-value="{{item}}" bindtap="profileChoice"><image src="{{asset}}gender-{{index === 0 ? 'woman' : 'man'}}.jpg" mode="aspectFill" /><text>{{index === 0 ? '女 | WOMAN' : '男 | MAN'}}</text><view>{{editValue === item ? '✓' : ''}}</view></button></view>
 <view wx:else>
  <view wx:if="{{editKey === 'handle'}}" class="bd-handle-label">帮搭号是账号唯一凭证</view>
  <view class="bd-counted-field {{editKey === 'bio' ? 'bd-counted-bio' : ''}}">
   <textarea wx:if="{{editKey === 'bio'}}" value="{{editValue}}" data-field="profile-edit" bindinput="profileInput" maxlength="40" placeholder="简单介绍下你自己"></textarea>
   <input wx:else value="{{editValue}}" data-field="profile-edit" bindinput="profileInput" maxlength="15" />
   <text>{{editValue.length}}/{{editKey === 'bio' ? 40 : 15}}</text>
  </view>
  <view wx:if="{{editKey === 'handle'}}" class="bd-form-hint">6-15个字符，仅可使用英文（必须）、数字、下划线</view>
 </view>
 <view class="bd-footer"><button class="bd-black bd-full" bindtap="saveProfileField">确定</button></view>
</view>
<view wx:if="{{view === 'topicEdit'}}" class="bd-topic-edit">
 <view wx:if="{{editingTopic}}" class="bd-manage-tabs"><button wx:for="{{['简介','可加入搭配','专题内搭配']}}" wx:key="*this" class="{{manageTab === item ? 'bd-selected' : ''}}" data-value="{{item}}" bindtap="manageTab">{{item === '专题内搭配' ? topicKind + '内搭配' : item === '简介' ? topicKind + '简介' : item}}</button></view>
 <view wx:if="{{manageTab === '简介'}}" class="bd-form"><view class="bd-heading">填写搭配{{topicKind}}名称</view><input value="{{topicName}}" data-key="topicName" data-field="topicName" bindinput="textInput" placeholder="好的{{topicKind}}搭配名称，更能吸引人" maxlength="30" /><view class="bd-heading">填写搭配{{topicKind}}描述</view><textarea value="{{topicDescription}}" data-key="topicDescription" data-field="topicDescription" bindinput="textInput" placeholder="简单介绍下你的{{topicKind}}" maxlength="200"></textarea><view class="bd-footer"><button class="bd-black bd-full" bindtap="saveTopic">{{editingTopic ? '修改' : '创建'}}</button><button wx:if="{{editingTopic}}" class="bd-topic-delete" bindtap="deleteTopic">删除{{topicKind}}</button></view></view>
 <view wx:else class="bd-manage-content"><view wx:if="{{!manageItems.length}}" class="bd-empty"><image src="{{asset}}empty-ref.jpg" mode="aspectFit" /></view><view class="bd-grid"><view wx:for="{{manageItems}}" wx:key="id" class="bd-manage-item" data-id="{{item.id}}" bindtap="manageSelect"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" /><view wx:else class="bd-collage bd-thumb"><image wx:for="{{item.items}}" wx:for-item="piece" wx:key="id" src="{{piece.editorImage || piece.image}}" mode="aspectFit" style="left:{{piece.x}}%;top:{{piece.y}}%;width:{{piece.size}}%;height:{{piece.size}}%;z-index:{{piece.z}}" /></view><view class="bd-selection-dot {{item.checked ? 'bd-selection-dot-on' : ''}}">{{item.checked ? '✓' : ''}}</view></view></view><view class="bd-footer"><button class="bd-black bd-full" bindtap="manageSave">{{manageTab === '可加入搭配' ? '加入' : '移出'}}{{topicKind}}（{{manageSelected.length || 0}}套）</button></view></view>
</view>
<view wx:if="{{view === 'privacy'}}" class="bd-privacy"><view wx:for="{{privacyRows}}" wx:key="key" class="bd-privacy-row"><text>{{item.title}}</text><text class="bd-visibility">{{item.enabled ? '公开' : '私密'}}</text><button class="bd-switch {{item.enabled ? 'bd-switch-on' : ''}}" data-key="{{item.key}}" bindtap="togglePrivacy" aria-label="{{item.title}}"><view></view></button></view></view>
<view wx:if="{{view === 'orders'}}" class="bd-empty bd-orders-empty"><image src="{{asset}}empty-ref.jpg" mode="aspectFit" /></view>
<view wx:if="{{view === 'certification'}}" class="bd-certification"><view class="bd-heading">请选择你的认证角色</view><button wx:for="{{['搭配达人','时尚博主','专业搭配师']}}" wx:key="*this" class="bd-role-card {{role === index ? 'bd-role-selected' : ''}}" data-index="{{index}}" bindtap="chooseRole"><image wx:if="{{role === index}}" src="{{asset}}role-photo.jpg" mode="aspectFill" /><view><view>{{item}}</view><text>{{['用户须使用简版搭配5套以上服饰，其中一套服饰搭配收获赞藏数在20以上，即可申请成为搭配达人','在任一自媒体平台有500以上粉丝的时尚博主','在形象美学、服装设计等专业机构进行过系统学习或正在从事相关专业工作岗位'][index]}}</text></view><text class="bd-role-check">✓</text></button><view class="bd-footer"><button class="bd-black bd-full" bindtap="roleNext">下一步</button></view></view>
<view wx:if="{{view === 'archive'}}" class="bd-archive">
 <view class="bd-archive-intro"><image src="{{asset}}archive-robot.jpg" mode="aspectFit" /><view class="bd-archive-style">适宜风格：<text>{{profile.style}}</text><text> ? </text></view><view class="bd-archive-tip">进行穿搭风格检测，生成你的穿搭关键词</view><view class="bd-archive-traits"><view wx:for="{{['色彩','明度','纯度','量感','形态','轮廓']}}" wx:key="*this"><image src="{{asset}}archive-trait-{{index}}.jpg" mode="aspectFit" />{{item}}</view></view><button bindtap="detectStyle">去检测</button></view><view class="bd-archive-greeting">🙋 嗨，{{profile.name}}</view><view class="bd-archive-subtitle">填写穿搭信息，搭配推荐更符合你的偏好</view>
 <view class="bd-archive-form"><view class="bd-heading">你的性别</view><view class="bd-radio-row"><button wx:for="{{['男','女']}}" wx:key="*this" class="{{form.gender === item ? 'bd-radio-selected' : ''}}" data-key="gender" data-value="{{item}}" bindtap="formChoice">{{item}}性</button></view>
 <view class="bd-archive-birthday"><text>你的年龄</text><picker mode="date" value="{{form.birthday || '1995-01-01'}}" data-key="birthday" bindchange="archiveRange"><view>{{form.birthday || '请选择你的出生年月日'}}</view></picker></view>
 <view class="bd-heading">你的身高</view><view class="bd-measure-value">{{form.height || 165}}<text>cm</text></view><view class="bd-ruler"><slider min="100" max="220" value="{{form.height || 165}}" data-key="height" bindchange="archiveRange" activeColor="transparent" backgroundColor="transparent" block-size="12" block-color="#ff9b6b" /><view><text>100</text><text>130</text><text>160</text><text>190</text><text>220</text></view></view>
 <view class="bd-heading">你的体重</view><view class="bd-measure-value">{{form.weight || 50}}<text>kg</text></view><view class="bd-ruler"><slider min="30" max="150" value="{{form.weight || 50}}" data-key="weight" bindchange="archiveRange" activeColor="transparent" backgroundColor="transparent" block-size="12" block-color="#ff9b6b" /><view><text>30</text><text>60</text><text>90</text><text>120</text><text>150</text></view></view>
 <view class="bd-heading">你的身型</view><view class="bd-shapes"><button wx:for="{{shapeOptions}}" wx:key="*this" class="{{form.shape === item ? 'bd-shape-on' : ''}}" data-key="shape" data-value="{{item}}" bindtap="formChoice"><image src="{{asset}}body-{{index}}.jpg" mode="aspectFit" /><text>{{item}}</text></button></view>
 <view class="bd-heading">现在所处阶段</view><view class="bd-chips bd-stage"><button wx:for="{{stageOptions}}" wx:key="*this" class="{{form.stage === item ? 'bd-chip-on' : ''}}" data-key="stage" data-value="{{item}}" bindtap="formChoice">{{item}}</button></view>
 <view wx:if="{{form.stage === '职场'}}" class="bd-occupation"><input value="{{form.occupation}}" bindinput="field" data-key="occupation" data-field="occupation" placeholder="请在此输入职业岗位如：小学老师" /><text>非必填，方便搭配师基于职业岗位着装特点推荐</text></view>
 <view class="bd-heading">你喜欢的风格 <text class="bd-muted">最多选择5项</text></view><view class="bd-archive-styles"><button wx:for="{{styleOptions}}" wx:key="name" class="{{item.checked ? 'bd-style-on' : ''}}" data-value="{{item.name}}" bindtap="archiveStyle"><image src="{{item.image}}" mode="aspectFill" /><text>{{item.name}}</text></button></view><button class="bd-black bd-full" bindtap="saveArchive">提交</button></view>
</view>
