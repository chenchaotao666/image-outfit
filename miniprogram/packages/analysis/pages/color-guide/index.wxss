/* Configured color matching guide */
.color-guide{padding:0!important}.color-guide-banner{background:#e7fafb;border-radius:24rpx;padding:42rpx 28rpx;margin:36rpx 0 52rpx;text-align:center}.color-guide-banner>view{font-size:36rpx;font-weight:700;margin:16rpx 0}.color-guide-banner>text{display:block;font-size:22rpx;color:#66999e}.color-plan{margin:28rpx 0}.color-plan-title{font-size:22rpx;color:#789094;margin-bottom:12rpx}.color-plan-swatches{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx}.guide-swatch{min-width:0;text-align:left}.guide-swatch>view{height:118rpx;border:1rpx solid #e7ecec}.guide-swatch>text{display:block;font-size:23rpx;margin-top:10rpx;color:#516267}.guide-swatch .swatch-code{font-size:19rpx;color:#849194;margin-top:4rpx}.guide-basics{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin:28rpx 0}.guide-basics .guide-swatch>view{height:100rpx}.guide-chapter{padding:48rpx 0 26rpx;border-top:1rpx solid #edf1f1;margin-top:36rpx}.guide-number{width:76rpx;height:76rpx;line-height:76rpx;text-align:center;border:1rpx solid #b9d9dc;border-radius:50%;margin:0 auto 22rpx;font-size:32rpx;color:#36585d}.guide-chapter-title{text-align:center;font-weight:700;font-size:29rpx}.guide-photos{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:24rpx;align-items:start}.guide-photos image{width:100%;display:block;border-radius:8rpx}.guide-photos>view>view{font-size:22rpx;line-height:1.6;color:#809095;margin-top:12rpx}.guide-footer{text-align:center;padding:32rpx 0}.color-guide>.story-subheading{margin-top:40rpx}


page{background:#fff}.color-guide{padding:24rpx 36rpx 64rpx!important}.color-guide-banner{margin-top:0;padding:64rpx 24rpx}.body-copy{font-size:28rpx;line-height:1.9;color:#90999c;margin:32rpx 0}.story-subheading{font-size:32rpx;font-weight:700}.caption{font-size:24rpx;line-height:1.7;color:#9aa5a8}.missing-guide{padding:80rpx 40rpx;text-align:center;color:#879699}.guide-photo-overlay{position:fixed;inset:0;background:#000d;z-index:100;display:flex;align-items:center;justify-content:center}.guide-photo-overlay image{width:90%;height:80vh}
