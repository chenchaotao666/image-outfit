.capture-stage {min-height:100vh;padding:5vh 24rpx calc(32rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;align-items:center;justify-content:space-evenly;background:linear-gradient(#626769,#777d7e);color:white}
.capture-stage .capture-hint,.capture-stage .capture-description {margin:12rpx 0;color:#fff}
.scan-ring {width:min(89vw,55vh);height:min(89vw,55vh);animation:face-scan-turn 8s linear infinite}
.face-outline {display:none}
.ring-inner {border-style:dashed}
@keyframes face-scan-turn {from{transform:rotate(0)}to{transform:rotate(360deg)}}
.capture-tools {display:flex;align-items:center;justify-content:space-between;width:88%}
.capture-tools button {width:95rpx;margin:0;padding:0;color:white;font-size:24rpx}
.capture-tools image {width:52rpx;height:52rpx;margin:auto}
.capture-tools .face-shutter {display:flex;align-items:center;width:128rpx;height:128rpx;border-radius:50%;background:linear-gradient(130deg,#00b9ce,#00e1cf)}
.detect .precautions,.detect .tutorial-sheet {width:100%;max-height:88vh;overflow-y:auto;padding:48rpx 40rpx calc(34rpx + env(safe-area-inset-bottom));border-radius:0}
.precautions .sheet-head,.tutorial-sheet .sheet-head {border-left-width:5rpx}
.precautions .notice-label {width:fit-content;margin:36rpx auto 16rpx;color:#343b3c;font-weight:650;box-shadow:inset 0 -12rpx #afe9ed}
.precautions .privacy-note {font-size:24rpx;color:#576365;margin:18rpx 0 32rpx}
.detect .precautions .primary,.detect .tutorial-sheet .primary {width:240rpx;min-height:78rpx;margin:32rpx auto 0;padding:16rpx 0}
.tutorial-row {display:flex;align-items:center;gap:28rpx;min-height:172rpx;font-size:26rpx}
.tutorial-row .step-number {font-size:80rpx;line-height:1;color:#a9e5ec;font-weight:700}
.tutorial-row image {width:138rpx;height:138rpx;margin-left:auto}
.tutorial-row:nth-child(2) {margin-top:42rpx}
.detect .confirm-photo {height:76vh;min-height:0;background:#999}
.confirm-panel {bottom:0;background:#999;padding:25rpx 40rpx calc(58rpx + env(safe-area-inset-bottom))}
.photo-tip {border-radius:20rpx;padding:20rpx;background:#777;color:white}
.detect .confirm-panel button {width:240rpx;min-height:74rpx;margin:0;padding:14rpx}
.profile-sheet {max-height:90vh;overflow-y:auto;padding:45rpx 46rpx calc(32rpx + env(safe-area-inset-bottom))}
.profile-sheet .gender-option,.profile-sheet .age-retry {width:auto;margin:0;padding:0}
.profile-sheet .field > text:first-child {width:36%;flex:none}
.profile-actions {padding-top:12rpx}
.profile-actions button {margin:0}
.body-modal {position:fixed;min-height:0;padding:32rpx 0;background:#0007}
.body-card {width:75%;padding:32rpx 35rpx;max-height:92vh;overflow-y:auto}
.body-card .body-photo-guide {width:65%;height:215rpx;margin:22rpx auto}
.body-card .primary {width:100%;min-height:70rpx;margin:10rpx 0;padding:14rpx 6rpx;font-size:27rpx}
.body-card .start-analysis,.body-card .back-link {width:auto;max-width:100%;margin:8rpx auto;background:transparent;color:#677679}
.body-card .start-analysis {font-size:24rpx}
.color-phase {background:radial-gradient(circle at 50% 42%,#7c39dc,#5641dc 39%,#267acb 90%)}
.color-phase .scan-line,.color-phase .scan-corners {display:none}
.color-orbit {position:absolute;top:42%;left:50%;transform:translate(-50%,-50%);width:330rpx;height:330rpx;border:6rpx dashed #ffffffb3;border-radius:50%;padding:20rpx}
.color-orbit image {width:100%;height:100%;border:6rpx solid #fff;border-radius:50%}
.color-phase .scan-bottom {border:2rpx solid #a3dfed;padding:28rpx;background:#30378e77}
