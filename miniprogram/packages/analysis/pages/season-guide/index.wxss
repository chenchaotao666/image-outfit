page{background:#fff;color:#333}.season-cover{width:100%;display:block}.season-cover-placeholder{height:560rpx;background:#214755;color:white;text-align:center;display:flex;flex-direction:column;justify-content:center;font-size:44rpx}.season-cover-placeholder text{font-size:28rpx;margin-top:18rpx}.season-introduction{position:relative;margin:-12rpx 32rpx 70rpx;padding:50rpx 36rpx;background:#fff;border-radius:32rpx;box-shadow:0 16rpx 45rpx #0000000c;color:#a1a1a1;font-size:27rpx;line-height:2.05}.intro-emphasis{margin-top:20rpx;color:#777}.season-overview{padding:0 36rpx 80rpx}.season-overview>view{font-size:35rpx;font-weight:700}.season-overview>text{display:block;font-size:24rpx;color:#aaa;margin-top:12rpx}.season-paper{background:#fdfdfd url('data:image/jpeg;base64,') repeat;background-size:220rpx auto}.season-section{padding:100rpx 0 10rpx}.season-heading{text-align:center;font-size:38rpx;font-weight:900;font-style:italic;letter-spacing:2rpx}.season-heading text{font-size:43rpx;letter-spacing:3rpx;margin-left:12rpx}.season-keywords{text-align:center;font-size:26rpx;color:#aaa;margin-top:24rpx}.season-arrow{width:0;height:0;border-left:15rpx solid transparent;border-right:15rpx solid transparent;border-top:12rpx solid #444;margin:30rpx auto 80rpx}.season-lead,.season-advice{width:560rpx;max-width:82%;margin:0 auto 90rpx;text-align:center;font-size:26rpx;line-height:2.15;color:#999}.season-lead>view+view{margin-top:22rpx}.season-outfit{width:500rpx;max-width:76%;margin:0 auto 112rpx}.season-outfit image{display:block;width:100%}.season-palette{height:42rpx;display:flex;gap:2rpx;margin-top:7rpx}.season-palette>view{flex:1}.season-palette>view:first-child{flex:1.75}.season-advice text{display:block;color:#b4b4b4;margin-top:28rpx}.season-footer{margin:70rpx 40rpx 0;padding:65rpx 0;border-top:1rpx solid #ddd;text-align:center;letter-spacing:6rpx;font:48rpx Georgia,serif}.season-missing{padding:70rpx 30rpx;text-align:center;color:#999}.season-photo-overlay{position:fixed;inset:0;background:#000e;z-index:100;display:flex;align-items:center;justify-content:center}.season-photo-overlay image{width:94%;height:85vh}
