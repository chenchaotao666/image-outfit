.glasses-panel {overflow:hidden; border-radius:32rpx; background:#fbf5eb; color:#ed9400; font-size:26rpx; line-height:1.5;}
.eyewear-hero {padding:28rpx 40rpx 40rpx;}
.eyewear-product {width:268rpx; margin-top:46rpx; text-align:center;}
.eyewear-disc {position:relative; display:flex; align-items:center; justify-content:center; width:242rpx; height:242rpx; margin:auto;}
.eyewear-backdrop {position:absolute; top:0; left:0; width:100%; height:100%;}
.eyewear-photo {position:relative; width:220rpx; height:110rpx;}
.eyewear-product text {display:block; margin-top:35rpx;}
.eyewear-options {padding:22rpx 24rpx 25rpx 40rpx; border-top:1rpx dashed #f5dfae; background:linear-gradient(55deg,#f8ecd5 0%,#fbf5eb 25%);}
.eyewear-row,.eyewear-pair,.eyewear-option,.eyewear-icon {display:flex; align-items:center;}
.eyewear-row {padding:12rpx 0;}
.eyewear-label {flex:none;}
.eyewear-pair {flex:1; min-width:0; column-gap:12rpx;}
.eyewear-option {flex:1; min-width:0; gap:10rpx; font-size:25rpx; line-height:1.4;}
.eyewear-icon {flex:none; justify-content:center; width:54rpx; color:#ee9900;}
.eyewear-icon .lens {box-sizing:border-box; width:22rpx; height:16rpx; border:2rpx solid currentColor; border-radius:3rpx;}
.eyewear-icon .bridge {width:7rpx; height:5rpx; border-top:2rpx solid currentColor; border-radius:50%;}
.shape-square .lens {height:18rpx;}
.shape-round .lens {width:21rpx; height:21rpx; border-radius:50%;}
.shape-oval .lens {border-radius:50%;}
.shape-half-rim .lens {border-radius:50%; border-bottom-color:transparent;}
.shape-trapezoid .lens {transform:perspective(24rpx) rotateX(-20deg);}

.brow-panel {padding:29rpx 40rpx; border-radius:30rpx; background:#fbf5eb;}
.brow-panel .gold-label {color:#ff9900; font-size:26rpx; line-height:1.4;}
.brow-feature {display:flex; align-items:center; gap:60rpx; margin:80rpx 0 84rpx; padding-left:40rpx;}
.brow-feature:last-child {margin-bottom:0;}
.brow-art {display:block; width:200rpx; height:200rpx; flex:none; border-radius:50%;}
.brow-content {flex:1; min-width:0;}
.brow-name {margin-bottom:9rpx; color:#333; font-size:30rpx; font-weight:400; line-height:1.4;}
.brow-content text {display:block; color:#f90; font-size:23rpx; line-height:1.55; overflow-wrap:break-word;}
