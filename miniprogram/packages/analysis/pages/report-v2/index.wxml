<view wx:if="{{loadError}}" class="empty"><text>{{loadError}}</text><button bindtap="loadReport">重试</button></view>
<view wx:if="{{missing}}" class="empty"><view>报告不存在或格式不支持</view><button bindtap="start" class="primary">重新检测</button></view>
<view wx:if="{{report}}" class="v2-page">
 <scroll-view scroll-x class="v2-tabs" scroll-into-view="tab-{{active}}"><view class="v2-tab-track"><view wx:for="{{tabs}}" wx:key="*this" id="tab-{{index}}" class="v2-tab {{active === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="tab">{{item}}</view></view></scroll-view>
 <view wx:if="{{report.mode === 'demo'}}" class="report-mode"><text>{{report.mode === 'demo' ? 'V2 示例报告 · 非本人检测' : 'AI 个人报告 · V2'}}</text><text>{{report.date}}</text></view>
 <view class="chapter" id="chapter-0"><view class="chapter-title">你的面部及体型数据</view><view class="chapter-body">
  <view class="hero-title">你的脸型类型为「{{vm.faceTitle}}」</view><view class="caption">拍照光线角度对结果有一定影响</view>
  <view class="face-board"><image src="/assets/report/portrait-complete.png" mode="aspectFit"/><view class="profile-pill p-age">年龄：{{report.profile.age}}</view><view class="profile-pill p-sex">性别：{{report.profile.gender}}</view><view class="profile-pill p-weight">体重：{{report.profile.weight}}kg</view><view class="profile-pill p-height">身高：{{report.profile.height}}cm</view></view>
  <view class="quote hero-quote"><view>你的脸型类型为「<text class="strong">{{vm.faceTitle}}</text>」</view><view class="strong">{{vm.copy.face}}</view></view>
  <view class="section-heading feature-heading">你的面部数据</view><view class="caption">拍照光线角度对结果有一定影响</view>
  <view class="face-section-space"></view>
  <view wx:for="{{vm.groups}}" wx:key="id" class="measurement">
   <view class="row-head"><view class="measurement-heading">AI检测你的「<text>{{item.short}}</text>」结果如下</view></view>
   <view class="measurement-result {{item.compact ? 'compact-result' : ''}}"><image src="{{item.diagram}}" mode="aspectFit"/><view class="measurement-conclusion"><view wx:for="{{item.conclusions}}" wx:for-item="line" wx:key="*this" class="result-label">{{line}}</view></view></view>
   <view wx:if="{{item.ratioSummary && report.geometry.provider !== 'Face++'}}" class="ratio-summary"><view>{{item.ratioSummary}}</view><text>{{item.ratioNote}}</text></view>

   <view wx:for="{{item.blocks}}" wx:for-item="block" wx:key="blockKey" class="metric-block"><view wx:if="{{block.name}}" class="metric-block-title">{{block.name}}</view><view wx:for="{{block.rows}}" wx:for-item="metric" wx:key="id" class="data-row {{metric.pending ? 'pending-row' : ''}}"><text>{{metric.label}}</text><text>{{metric.display}}</text></view></view>
   <view wx:if="{{item.showReason}}" class="unavailable">{{item.reason}}</view><button wx:if="{{item.action}}" class="small-link measurement-retry" data-id="{{item.id}}" bindtap="explain">{{item.action}} →</button>

   <view wx:if="{{item.id === 'outline'}}" class="inline-recommendation">
    <view class="recommendation-heading" wx:if="{{vm.copy.generalEyewear}}">眼镜试戴参考</view>
    <view class="recommendation-heading" wx:else>脸型适合「<text class="strong">眼镜</text>」推荐如下</view>
    <view wx:if="{{vm.copy.glasses.length}}" class="glasses-panel" data-kind="glasses" bindtap="detail">
     <view class="eyewear-hero">
      <view>最合适：</view>
      <view class="eyewear-product">
       <view class="eyewear-disc">
        <image class="eyewear-backdrop" src="/packages/analysis/assets/eyewear-disc.svg" mode="aspectFit" aria-hidden="true"/>
        <image class="eyewear-photo" src="{{vm.copy.glasses[0].image}}" mode="aspectFit"/>
       </view>
       <text>{{vm.copy.glasses[0].displayName}}</text>
      </view>
     </view>
     <view class="eyewear-options">
      <view wx:for="{{vm.copy.eyewearRows}}" wx:key="tier" wx:for-item="row" class="eyewear-row">
       <text class="eyewear-label">{{row.tier}}：</text>
       <view class="eyewear-pair">
        <view wx:for="{{row.frames}}" wx:for-item="frame" wx:key="name" class="eyewear-option">
         <view wx:if="{{frame.shape}}" class="eyewear-icon shape-{{frame.shape}}" aria-hidden="true"><view class="lens"></view><view class="bridge"></view><view class="lens"></view></view>
         <text>{{frame.displayName}}</text>
        </view>
       </view>
      </view>
     </view>
    </view>
    <view wx:else class="caption">这份报告的脸型与镜框资料不足，重新检测后可查看完整推荐。</view>
   </view>
   <view wx:if="{{item.id === 'brows'}}" class="inline-recommendation">
    <view class="recommendation-heading">脸型适合「<text class="strong">眉型</text>」推荐如下</view>
    <view class="brow-panel" bindtap="browReason">
     <view class="gold-label">{{report.mode === 'demo' ? '示例脸型特点：' : '你的脸型特点：'}}</view>
     <view class="brow-feature">
      <image class="brow-art" src="/packages/analysis/assets/brow-face.png" mode="aspectFit"/>
      <view class="brow-content"><view class="brow-name">{{vm.browRecommendation.faceLabel}}</view>
       <text wx:for="{{vm.copy.browFaceLines}}" wx:key="*this">{{item}}</text>
      </view>
     </view>
     <view class="gold-label">推荐尝试的妆容眉型：</view>
     <view class="brow-feature">
      <image class="brow-art" src="/assets/report/brow-detail.png" mode="aspectFit"/>
      <view class="brow-content"><view class="brow-name">{{vm.browRecommendation.name}}</view>
       <text wx:for="{{vm.browRecommendation.steps}}" wx:key="index">{{item}}</text>
      </view>
     </view>
    </view>
   </view>
  </view>
  <view class="assessment-section" id="skin-section"><view class="skin-heading-row"><view class="section-heading feature-heading">{{vm.copy.skinTitle}}</view></view><view class="caption">{{report.mode === 'demo' ? '示例报告' : '根据本次照片检测'}}</view><view class="quote skin-conclusions"><text wx:if="{{vm.copy.skin.length}}">本次检测结果：</text><text wx:for="{{vm.copy.skin}}" wx:key="id" class="skin-finding {{item.status === 'present' ? 'skin-positive' : ''}}" data-id="{{item.id}}" bindtap="skinFinding">{{item.text}}{{index === vm.copy.skin.length - 1 ? '。' : '，'}}</text><text wx:if="{{!vm.copy.skin.length}}">{{vm.skinAssessment.photoSummary}}</text><text class="skin-closing">日常注意温和清洁、保湿和防晒。</text></view><view wx:if="{{vm.skinAdvanced}}" class="skin-advanced"><button class="skin-photo-open" bindtap="openSkinImage" data-key="original">查看检测图片 →</button><view wx:for="{{vm.skinAdvanced.sections}}" wx:for-item="section" wx:key="title" class="skin-data-section"><view class="story-subheading">{{section.title}}</view><view wx:for="{{section.rows}}" wx:for-item="metric" wx:key="label" class="data-row"><text>{{metric.label}}</text><view class="skin-data-value"><text>{{metric.value}}</text><button wx:if="{{metric.image}}" class="skin-photo-link" data-key="{{metric.key}}" bindtap="openSkinImage">查看图片</button></view></view></view></view></view>
  <view class="section-heading feature-heading">你的身材与比例</view><view class="caption">{{vm.referenceBody.photoCount ? '根据全身照与身高估算' : '根据身高比例估算'}}</view><image src="/assets/report/body-measurement.png" mode="aspectFit" class="body-illustration"/><view class="body-progress"><text wx:for="{{['体重偏轻','体重正常','体重超重','体重肥胖']}}" wx:key="*this" class="{{vm.bmiBand === index ? 'active' : ''}}">{{item}}</text></view>
  <view class="body-data-card"><view class="floating-label">你的「体型分析」结果如下</view><view class="bmi-heading">BMI体质指数</view><view class="bmi-value">「{{vm.bmi}}」<text>（体重kg / 身高²m²）</text></view><view class="body-divider"></view><view wx:for="{{vm.referenceBody.rows}}" wx:key="id" class="data-row"><view>{{item.label}}<text wx:if="{{item.value && item.source !== '身高比例参考'}}" class="body-row-source">{{item.source}}</text></view><text class="{{item.value ? '' : 'pending-value'}}">{{item.value ? item.display : '—'}}</text></view><view class="body-ratios"><view wx:if="{{report.manualMeasurements && report.manualMeasurements.waist && report.manualMeasurements.hip}}">腰臀比<text>{{vm.bodyRatios.waistHip}}</text></view><view wx:if="{{report.manualMeasurements && report.manualMeasurements.leg}}">腿长 / 身高<text>{{vm.bodyRatios.legHeight}}</text></view></view><button class="small-link" bindtap="editMeasurements">校正尺寸（可选） →</button></view>
  <view class="assessment-section" id="score-section"><view class="section-heading feature-heading">{{vm.stylingScore.complete ? '你的造型评分为' + vm.stylingScore.total + '分' : '你的造型评分 · 待补充'}}</view><view class="caption">{{vm.stylingScore.config.copy.caption}}</view>
  <view wx:if="{{vm.stylingScore.complete}}" class="score-meter"><canvas canvas-id="completion" id="completion" style="width:{{chartWidth}}px;height:{{chartHeight * 0.58}}px"></canvas><view class="score-value">{{vm.stylingScore.complete ? vm.stylingScore.total : '待补充'}}<text>{{vm.stylingScore.label}}</text></view></view><view wx:if="{{vm.stylingScore.complete}}" class="score-bands"><text wx:for="{{vm.stylingScore.config.bands}}" wx:key="min">{{item.min}}–{{item.max}} {{item.label}}</text></view><view class="micro center">{{vm.stylingScore.config.copy.boundary}}</view>
  <view class="score-breakdown compact-hidden"><view wx:for="{{vm.stylingScore.rows}}" wx:key="id" class="score-row"><view><text>{{item.name}}</text><text>{{item.score === null ? '待补充' : item.score + ' / ' + item.weight}}</text></view><view class="score-track"><view style="width:{{item.score === null ? 0 : item.score / item.weight * 100}}%"></view></view></view></view><view wx:if="{{!vm.stylingScore.complete}}" class="unavailable">已获得 {{vm.stylingScore.count}} / 5 项评价。{{vm.stylingScore.count ? '部分项目证据不足，点击下方查看具体原因。' : '本次报告未返回可用评分，请查看原因后再补充。'}}</view><button class="small-link" bindtap="scoreDetails">查看评分依据与改善建议 →</button></view>
  <view class="chapter-takeaway">
   <view class="floating-label">形象提升建议</view>
   <view>不要以为匆匆忙忙随手穿在身上的衣服对自己没有影响，</view>
   <view>一个人的命运往往取决于某些不为人知的细节</view>
   <view>国际心理学专家研究指出，</view>
   <view class="strong">良好的外在形象，会在职场和人际交往中使人对我们的认同和欣赏感提高30%。</view>
  </view>
 </view></view>

 <view class="chapter" id="chapter-1"><view class="chapter-title">你的面部及服装单品属性</view><view class="chapter-body style-chapter">
  <view wx:for="{{vm.referenceStyles}}" wx:key="key" class="style-story"><view class="row-head story-head"><view>Ⅰ {{item.heading}}「{{item.label}}」</view><button class="explain" data-tip="{{item.key}}" bindtap="tip">ⓘ</button></view><image src="/assets/report/style-faces.jpg" mode="aspectFit" class="scale-art"/><view class="scale-strip"><view wx:for="{{item.items}}" wx:for-item="option" wx:for-index="n" wx:key="*this" class="{{item.selected === n ? 'selected' : ''}}">{{option}}</view></view><view class="body-copy">{{item.explanation}}</view><view class="row-head"><view class="story-subheading">Ⅰ {{item.garmentTitle}}「{{item.selected === null ? '待补充' : item.garmentItems[item.selected]}}」</view><button class="explain" data-tip="{{item.key}}-clothes" bindtap="tip">ⓘ</button></view><image src="{{item.image}}" mode="aspectFit" class="garment-examples"/><view class="scale-strip garment-scale"><view wx:for="{{item.garmentItems}}" wx:for-item="option" wx:for-index="n" wx:key="*this" class="{{item.selected === n ? 'selected' : ''}}">{{option}}</view></view><view class="body-copy">{{item.suggestion}}</view></view>
  <view class="section-heading feature-heading">推荐你尝试的个人风格「{{vm.primaryStyle}}」</view><view class="caption">根据面部检测特征综合推荐</view><canvas canvas-id="radar" id="radar" style="width:{{chartWidth}}px;height:{{chartHeight}}px" class="chart"></canvas><view class="caption">风格方向示意 · 不表示评分或匹配概率</view><view wx:if="{{vm.personalStyleEvidence}}" class="quote">{{vm.personalStyleEvidence.reason}}<view>{{vm.personalStyleEvidence.advice}}</view></view><view wx:else class="quote">{{vm.copy.style}}<view class="caption">此旧报告未保存规则记录，重新分析可查看可追溯依据。</view></view><view class="action-card" bindtap="openStyleGuide"><view>{{vm.styleGuideCopy.actionHeading}}</view><text>{{vm.styleGuideCopy.actionLabel}}</text><view class="action-watermark watermark-style">◕</view></view>
 </view></view>

 <view class="chapter" id="chapter-2"><view class="chapter-title">你的面部色彩属性</view><view class="chapter-body">
  <view wx:for="{{vm.referenceColors}}" wx:key="key" class="color-analysis"><view class="row-head"><view class="story-subheading">Ⅰ {{item.heading}}「{{item.label}}」</view><button class="explain" data-tip="{{item.key}}" bindtap="tip">ⓘ</button></view><view class="caption">拍照光线和化妆情况会影响色彩观察</view><image src="{{item.image}}" mode="aspectFit" class="color-comparison"/><view wx:if="{{item.selected !== null}}" class="scale-strip"><view wx:for="{{item.items}}" wx:for-item="option" wx:for-index="n" wx:key="*this" class="{{item.selected === n ? 'selected' : ''}}">{{option}}</view></view><view class="body-copy">{{item.text}}</view><view wx:if="{{item.advice}}" class="body-copy">{{item.advice}}</view></view>
  <view class="section-heading feature-heading">{{vm.colorGuide.reportCopy.heading}}「{{vm.colorGuide.label}}」</view><view class="caption">{{vm.colorGuide.reportCopy.caption}}</view><image class="color-system" src="/assets/report/color-system.png" mode="aspectFit"/><view class="row-head"><view class="section-heading small-heading">{{vm.colorGuide.reportCopy.analysisHeading}}</view><button class="explain" bindtap="colorBasis">ⓘ</button></view><view class="quote color-summary">{{vm.colorGuide.summary}}</view><view class="action-card" bindtap="openColorGuide"><view>{{vm.colorGuide.reportCopy.actionHeading}}</view><text>{{vm.colorGuide.reportCopy.actionLabel}}</text><view class="action-watermark watermark-color">◉</view></view>
 </view></view>

 <view class="chapter editorial-chapter" id="chapter-3"><view class="chapter-body"><view class="section-heading feature-heading">你的季节色系穿搭分析</view><view class="caption">根据色彩方向与日常场景规划</view><view wx:if="{{vm.showReference}}" class="editorial-gallery"><view class="mood-columns"><view class="mood-column" wx:for="{{[0,1]}}" wx:for-item="column" wx:key="*this"><view wx:for="{{vm.looks}}" wx:if="{{index % 2 === column}}" wx:key="image" class="mood-card" data-kind="looks" data-index="{{index}}" bindtap="inspiration"><image src="{{item.image}}" mode="widthFix" bindload="positions"/></view></view></view></view><view class="quote">{{vm.copy.season}}</view><view class="action-card" bindtap="openSeasonGuide"><view>已为你规划四季色系搭配示范</view><text>点击查看你的专属季节色系</text><view class="action-watermark watermark-season">☁</view></view><view wx:if="{{expanded.seasons}}" class="outfit-grid"><view wx:for="{{vm.outfits}}" wx:key="season" class="outfit-card" data-index="{{index}}" bindtap="outfit"><view class="season-header">{{item.season}}<view class="outfit-colors"><view wx:for="{{item.colors}}" wx:for-item="color" wx:key="*this" style="background:{{color}}"></view></view></view><view class="outfit-title">{{item.title}}</view><view class="micro">{{item.top}}<view>{{item.bottom}}</view></view><text class="small-link">查看完整搭配 →</text></view></view></view></view>

 <view class="chapter" id="chapter-4"><view class="chapter-title">你的衣橱规划</view><button class="wardrobe-basis" bindtap="wardrobeBasis">查看规划依据 ⓘ</button><view class="chapter-body"><view class="section-heading">你的衣橱色彩规划如下</view><view class="caption">根据分析风格提供衣橱起始方案</view><view class="ratio-plans"><view><view>基础色</view><image src="/assets/report/wardrobe-base.jpg" mode="aspectFit"/><text>{{vm.basePercent}}%</text></view><view><view>时尚色</view><image src="/assets/report/wardrobe-color.jpg" mode="aspectFit"/><text>{{vm.fashionPercent}}%</text></view></view><view class="quote"><view>{{vm.wardrobePlan.colorText}}</view>建议比例：<text class="strong">基础色 {{vm.basePercent}}% · 时尚色 {{vm.fashionPercent}}%。</text></view>
  <view class="section-heading feature-heading">你的衣橱款式规划如下</view><view class="caption">以分析风格与重复搭配需求为依据</view><view class="ratio-plans style-plans"><view><view>基础款</view><image src="/assets/report/wardrobe-classic.jpg" mode="aspectFit"/><text>{{vm.basicStylePercent}}%</text></view><view><view>设计款</view><image src="/assets/report/wardrobe-fashion.jpg" mode="aspectFit"/><text>{{vm.designStylePercent}}%</text></view></view><view class="quote"><view>{{vm.wardrobePlan.styleText}}</view>建议比例：<text class="strong">简约基础款 {{vm.basicStylePercent}}% · 风格设计款 {{vm.designStylePercent}}%。</text></view>
  <view class="section-heading feature-heading">你的衣橱单品规划如下</view><view class="caption">按常用场景安排单品，先盘点再补充</view><view class="wardrobe-chart-row"><canvas canvas-id="wardrobe" id="wardrobe" style="width:{{wardrobeWidth}}px;height:{{wardrobeWidth}}px"></canvas><view class="wardrobe-legend"><view wx:for="{{vm.wardrobe}}" wx:key="name"><view class="legend-color" style="background:{{item.color}}"></view><text>{{item.name}}：{{item.percent}}%</text></view></view></view><view class="section-heading small-heading">衣橱单品占比</view><view class="quote"><view>{{vm.wardrobePlan.quantityText}}</view>建议单品占比：{{vm.wardrobeSummary}}。</view><view class="section-heading small-heading">衣橱单品组合建议</view><view class="quote">{{vm.wardrobePlan.combinationText}}</view><view class="action-card" bindtap="openWardrobeGuide"><view>已为你生成衣橱规划</view><text>点击查看你的专属衣橱单品</text><view class="action-watermark watermark-closet">♧</view></view>
 </view></view>

 <view class="chapter editorial-chapter" id="chapter-5"><view class="chapter-body"><view class="section-heading feature-heading">你的 TPO 场合形象分析</view><view class="caption">时间 · 地点 · 场合</view><view wx:if="{{vm.showReference}}" class="editorial-gallery"><view class="mood-columns"><view class="mood-column" wx:for="{{[0,1]}}" wx:for-item="column" wx:key="*this"><view wx:for="{{vm.occasionGallery}}" wx:if="{{index % 2 === column}}" wx:key="image" class="mood-card" data-kind="occasions" data-index="{{index}}" bindtap="inspiration"><image src="{{item.image}}" mode="widthFix" bindload="positions"/></view></view></view></view><view class="quote">{{vm.copy.tpo.intro}}<text style="font-weight:600;color:#333">{{vm.copy.tpoCategories}}</text>{{vm.copy.tpo.ending}}</view><view class="action-card" data-kind="occasions" bindtap="toggleSection"><view>已为你规划 TPO 场合形象示范</view><text>{{expanded.occasions ? '收起场合着装建议' : '点击查看你的专属场合搭配'}}</text><view class="action-watermark watermark-tpo">♙</view></view><view wx:if="{{expanded.occasions}}" class="expanded-section"><view wx:for="{{report.analysis.occasions}}" wx:key="occasion" class="occasion-card" data-kind="tpo" data-index="{{index}}" bindtap="detail"><view class="story-subheading">{{item.occasion}}</view><view class="body-copy">{{item.recommendation}}</view><text class="small-link">展开着装建议 →</text></view></view></view></view>

 <view class="chapter editorial-chapter" id="chapter-6"><view class="chapter-body"><view class="section-heading feature-heading">你的最佳发型风格分析</view><view class="caption">根据面部轮廓与打理偏好规划</view><view wx:if="{{vm.showReference}}" class="editorial-gallery"><view class="mood-columns"><view class="mood-column" wx:for="{{[0,1]}}" wx:for-item="column" wx:key="*this"><view wx:for="{{vm.hairstyles}}" wx:if="{{index % 2 === column}}" wx:key="image" class="mood-card" data-kind="hair" data-index="{{index}}" bindtap="inspiration"><image src="{{item.image}}" mode="widthFix" bindload="positions"/></view></view></view></view><view class="quote">{{vm.copy.hair}}</view><view class="action-card" data-kind="hair" bindtap="toggleSection"><view>已为你规划发色发型示范</view><text>{{expanded.hair ? '收起发型打理建议' : '点击查看你的专属发色发型'}}</text><view class="action-watermark watermark-hair">◐</view></view><view wx:if="{{expanded.hair}}" class="expanded-section"><view wx:for="{{report.analysis.details.hairOptions}}" wx:key="name" class="hair-card" data-kind="hair" data-index="{{index}}" bindtap="detail"><view class="result-label">{{item.name}}</view><view class="body-copy">{{item.reason}}</view><text class="small-link">查看打理方法 →</text></view><view class="hair-colors"><text wx:for="{{report.analysis.hair.colors}}" wx:key="*this">{{item}}</text></view></view></view></view>
 <view class="report-end"><view>本报告用于个人穿搭参考</view><view wx:for="{{report.analysis.warnings}}" wx:key="*this" class="micro">{{item}}</view><button class="small-link" bindtap="start">重新检测 / 补充照片 →</button></view>
 <button class="report-helper" bindtap="consult">报告<text>解读</text></button>
 <view wx:if="{{dialog}}" class="detail-shade {{dialog.tip ? 'tip-shade' : ''}}" bindtap="close"><view class="detail-sheet {{dialog.tip ? 'tip-sheet' : ''}}" catchtap="noop"><view wx:if="{{dialog.tip}}" class="tip-kicker">TIPS</view><view class="detail-head"><view>{{dialog.title}}</view><button bindtap="close">×</button></view><scroll-view scroll-y class="detail-content"><view wx:if="{{dialog.scorePhotoNote}}" class="score-photo-evidence"><view class="evidence-note">{{dialog.scorePhotoNote}}</view><image wx:if="{{dialog.scorePhoto}}" src="{{dialog.scorePhoto}}" mode="widthFix" class="score-body-photo"/></view><view wx:if="{{dialog.skinViewer}}" class="skin-viewer"><view class="skin-image-tabs"><button wx:for="{{dialog.skinViewer.options}}" wx:key="key" class="{{item.key === dialog.skinViewer.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="openSkinImage">{{item.label}}</button></view><view wx:if="{{dialog.skinViewer.key !== 'original'}}"><view class="skin-viewer-count">{{dialog.skinViewer.label}}：检出 {{dialog.skinViewer.count}} 处</view><view wx:if="{{dialog.skinViewer.photo}}"><view class="caption">拖动图片上的竖线，对比标记与原图</view></view><view wx:if="{{dialog.skinViewer.count === 0}}" class="caption">本次未检出该项目。</view><view wx:else class="caption">方框为检测到的候选位置。</view></view><view wx:if="{{dialog.skinViewer.photo}}" class="skin-compare-photo" style="padding-top:{{dialog.skinViewer.padding}}%;"><image src="{{dialog.skinViewer.photo}}" mode="scaleToFill"/><view wx:if="{{dialog.skinViewer.key !== 'original'}}" class="skin-box-layer" style="clip-path:inset(0 {{100-dialog.skinViewer.compare}}% 0 0);"><view wx:for="{{dialog.skinViewer.boxes}}" wx:key="id" class="skin-detection-box" style="{{item.style}}"></view></view><view wx:if="{{dialog.skinViewer.key !== 'original'}}" class="skin-compare-divider" catchtouchstart="skinDragStart" catchtouchmove="skinDragMove" catchtouchend="skinDragEnd" catchtouchcancel="skinDragEnd" style="left:{{dialog.skinViewer.compare}}%;"><text>↔</text></view></view><view wx:else class="evidence-missing">此报告未保存照片，请重新分析后查看。</view></view><view wx:if="{{dialog.diagram}}" class="evidence-guide"><image src="{{dialog.diagram}}" mode="aspectFit"/><text>位置示意（非本人测量线）</text></view><view wx:if="{{dialog.evidence}}" class="photo-evidence"><view wx:if="{{dialog.evidence.missing}}" class="evidence-missing">{{dialog.evidence.message}}</view><view wx:else><view class="evidence-heading">{{dialog.evidence.title}}<button bindtap="toggleEvidence">{{dialog.evidence.full ? '放大测量区域' : '查看整张照片'}}</button></view><view class="evidence-stage" style="padding-top:{{dialog.evidence.padding}}%;"><image src="{{dialog.evidence.photo}}" mode="scaleToFill" style="{{dialog.evidence.imageStyle}}"/><view wx:for="{{dialog.evidence.lines}}" wx:for-item="line" wx:key="key" class="evidence-line" style="{{line.style}}"></view><view wx:for="{{dialog.evidence.dots}}" wx:for-item="dot" wx:key="key" class="evidence-dot" style="{{dot.style}}"><text wx:if="{{dot.text}}" style="{{dot.labelStyle}}">{{dot.text}}</text></view></view><view class="evidence-note">{{dialog.evidence.note}}</view><view wx:for="{{dialog.evidence.legend}}" wx:for-item="mark" wx:key="key" class="evidence-legend"><view><text style="background:{{mark.color}}"></text>{{mark.label}}</view><text>{{mark.text}}</text></view></view></view><image wx:if="{{dialog.image}}" src="{{dialog.image}}" mode="aspectFit" class="detail-photo"/><view wx:for="{{dialog.paragraphs}}" wx:key="*this" class="body-copy">{{item}}</view><view class="outfit-colors"><view wx:for="{{dialog.colors}}" wx:key="*this" style="background:{{item}}"></view></view><view wx:for="{{dialog.items}}" wx:key="name" class="detail-item"><view>{{item.name}}</view><text>{{item.text}}</text></view><view wx:if="{{dialog.editSkin}}" class="skin-form"><view wx:for="{{skinDraft}}" wx:key="id" class="skin-question"><view>{{item.label}}</view><view class="skin-options"><button wx:for="{{skinOptions}}" wx:for-item="option" wx:key="id" data-field="{{item.id}}" data-value="{{option.id}}" bindtap="skinAnswer" class="{{item.value === option.id ? 'selected' : ''}}">{{option.label}}</button></view></view><view wx:if="{{manualError}}" class="form-error">{{manualError}}</view></view><view wx:if="{{dialog.editBody}}" class="measurement-form"><view wx:for="{{bodyDraft}}" wx:key="id" class="manual-field"><text>{{item.label}}</text><input type="digit" value="{{item.value}}" data-field="{{item.id}}" bindinput="measurementInput" placeholder="可留空"/><text>cm</text></view><view wx:if="{{manualError}}" class="form-error">{{manualError}}</view></view></scroll-view><button wx:if="{{dialog.editSkin}}" class="primary" bindtap="saveSkin">保存肤感记录</button><button wx:if="{{dialog.editBody}}" class="primary" bindtap="saveMeasurements">保存尺量数据</button><button wx:if="{{!dialog.editBody && !dialog.editSkin}}" class="primary" bindtap="close">我知道了</button></view></view>
</view>
