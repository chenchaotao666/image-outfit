/* Upload */
.upload-tutorial {
  padding: 42rpx 65rpx 48rpx;
  min-height: calc(100vh - 160rpx);
  background: linear-gradient(#fff, #ecf8fa);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tutorial-capsule {
  border: 2rpx solid #555957;
  border-radius: 310rpx;
  padding: 55rpx 42rpx 38rpx;
  background: white;
  box-shadow: inset 0 0 0 20rpx #f5f5f5;
  width: 100%;
  min-height: 810rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
}
.tutorial-photo {
  width: 100%;
  height: 340rpx;
  border-radius: 200rpx 200rpx 0 0;
  background: #f0f0f0;
}
.tutorial-number {
  font-family: Georgia, serif;
  font-style: italic;
  font-size: 64rpx;
  line-height: 1.15;
}
.tutorial-copy {
  font-size: 27rpx;
  line-height: 1.9;
  margin-top: 22rpx;
  min-height: 160rpx;
}
.tutorial-dots {
  display: flex;
  gap: 14rpx;
  justify-content: center;
  margin: 40rpx 0 6rpx;
}
.tutorial-dots text {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d8dbda;
}
.tutorial-dots .active {
  background: #353a37;
}
.tutorial-en {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 7rpx;
  margin: 50rpx 0 70rpx;
  color: #111;
}
.upload-preview {
  width: 100%;
  height: 360rpx;
  background: white;
  margin-bottom: 26rpx;
}
.form-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #eee;
}
.form-row > text {
  width: 100rpx;
  flex-shrink: 0;
}
.form-row input {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
}
.required {
  color: #db816e;
}
