/* Settings and overlays */
.settings-profile {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 8rpx 50rpx;
}
.settings-profile > image {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
}
.settings-view .list-card {
  margin-bottom: 60rpx;
}
.skin-carousel {
  white-space: nowrap;
  width: 100%;
  padding-top: 55rpx;
}
.skin-slide {
  display: inline-block;
  vertical-align: top;
  width: 590rpx;
  margin-right: 32rpx;
  text-align: center;
  padding: 0 20rpx;
}
.skin-slide > image {
  width: 100%;
  height: 780rpx;
  border-radius: 300rpx 300rpx 0 0;
}
.skin-name {
  font-size: 30rpx;
  font-weight: 600;
  margin: 42rpx 0 24rpx;
}
.skin-line {
  width: 34rpx;
  height: 5rpx;
  background: #333;
  margin: 0 auto 50rpx;
}
.season-radio {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
}
.season-radio.checked {
  border: 7rpx solid #6d8b7d;
}
.weather-view {
  background: radial-gradient(ellipse at 10% 20%, #fff, #e3e8e9 65%);
  min-height: calc(100vh - 150rpx);
}
.weather-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 35rpx 0 80rpx;
}
.weather-heading > button {
  font-size: 25rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.weather-heading image {
  width: 29rpx;
  height: 29rpx;
}
.weather-card {
  display: flex;
  background: #ffffffa8;
  padding: 25rpx 40rpx;
  gap: 50rpx;
  align-items: center;
}
.weather-card > view {
  flex: 1;
}
.weather-card text {
  display: block;
  font-size: 26rpx;
  margin: 8rpx 0;
}
.weather-card .weather-temperature {
  font-size: 38rpx;
  color: #f2b24f;
}
.weather-metrics {
  color: #9da4a4;
}
.weather-metrics > text {
  font-size: 23rpx;
  margin: 17rpx 0;
  white-space: nowrap;
}
.weather-note {
  font-size: 22rpx;
  color: #9ca6a6;
  margin: 23rpx 0 50rpx;
}
.weather-indices {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25rpx;
}
.weather-indices > view {
  display: flex;
  align-items: center;
  gap: 25rpx;
  background: #ffffffa0;
  padding: 23rpx;
  color: #a0a7a5;
}
.weather-indices image {
  width: 50rpx;
  height: 50rpx;
  background: #dbf3f0;
  padding: 5rpx;
}
.weather-indices > view > text > .subtle {
  display: block;
}
.help-banner {
  background: linear-gradient(120deg, #e0f0e7, #eff6e5);
  padding: 40rpx 28rpx;
  position: relative;
  margin-bottom: 45rpx;
}
.help-banner > text {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}
.help-banner > text + text {
  font-size: 23rpx;
  color: #86a194;
  margin-top: 10rpx;
  font-weight: 400;
}
.help-banner image {
  position: absolute;
  right: 25rpx;
  top: 40rpx;
  width: 70rpx;
  height: 70rpx;
  opacity: 0.5;
}
.help-section {
  margin: 30rpx 0 45rpx;
  line-height: 1.9;
}
.help-section > view {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.help-section > text {
  font-size: 25rpx;
  color: #89928d;
}
.feedback-input {
  box-sizing: border-box;
  background: #fff;
  width: 100%;
  height: 300rpx;
  padding: 26rpx;
  font-size: 26rpx;
  border: 0;
}
.feedback-note {
  margin: 24rpx 0 35rpx;
}
.feedback-record {
  background: #fff;
  padding: 26rpx;
  margin-bottom: 20rpx;
  font-size: 25rpx;
  word-break: break-all;
}
.closet-overlay {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: #0008;
  display: flex;
  align-items: flex-end;
}
.closet-sheet {
  background: #fff;
  width: 100%;
  padding: 12rpx 34rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 3rpx solid #9ddbd1;
  max-height: 85vh;
  overflow: auto;
  box-shadow: 0 -8rpx 45rpx #0001;
}
.sheet-grip {
  width: 60rpx;
  height: 5rpx;
  background: #e5e8e7;
  margin: 0 auto 20rpx;
  border-radius: 10rpx;
}
.sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}
.sheet-heading button {
  padding: 8rpx;
}
.sheet-heading image {
  width: 25rpx;
  height: 25rpx;
}
.sheet-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 25rpx;
  width: 100%;
  padding: 23rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.sheet-option image {
  width: 33rpx;
  height: 33rpx;
}
.sheet-note {
  font-size: 22rpx;
  color: #a8aeab;
  text-align: center;
  padding: 20rpx;
}
.sheet-cancel {
  width: 100%;
  border-top: 6rpx solid #f7f7f7;
  padding-top: 24rpx;
  margin-top: 28rpx;
  font-size: 25rpx;
  color: #969d99;
}
.sheet-input {
  height: 86rpx;
  background: #f5f6f5 !important;
  padding: 20rpx;
  margin: 28rpx 0;
  font-size: 27rpx;
}
.inline-reset {
  display: inline-block;
  float: right;
  font-size: 23rpx;
  color: #a6aba8;
}
.occasion-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 25rpx 0 40rpx;
}
.occasion-grid > button {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #f4f5f4;
  padding: 22rpx;
  font-size: 24rpx;
  border: 1rpx solid transparent;
}
.occasion-grid .selected {
  border-color: #8ccdbc;
  background: #edf8f2;
}
.occasion-grid image {
  width: 40rpx;
  height: 40rpx;
}
.switch-closet-card {
  margin: 20rpx 0 35rpx;
  width: 250rpx;
  background: #f8f9f8;
  text-align: center;
  padding: 14rpx;
  font-size: 25rpx;
}
.switch-closet-card image {
  width: 100%;
  height: 200rpx;
  margin-bottom: 10rpx;
}
.switch-closet-card > text {
  font-size: 21rpx;
}
.loading-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: #fff9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 25rpx;
  color: #61716a;
  font-size: 27rpx;
}
.loading-spinner {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #ddd;
  border-top-color: #66bba6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.subcategory-tabs {
  white-space: nowrap;
  margin: -22rpx 0 24rpx;
  width: 100%;
}
.subcategory-tabs button {
  display: inline-block;
  font-size: 21rpx;
  color: #999;
  padding: 10rpx 15rpx;
}
.subcategory-tabs .active {
  color: #333;
  border-bottom: 2rpx solid #333;
}
.stats-ring {
  border: 0;
  padding: 35rpx;
}
.stats-ring > view {
  background: #fff;
  border-radius: 50%;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.closet-app text{white-space:normal!important}
