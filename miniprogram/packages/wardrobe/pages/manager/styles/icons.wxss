/* One box and stroke weight for navigation and disclosure arrows. */
.ui-chevron {display:inline-block;position:relative;width:24rpx;height:24rpx;flex:0 0 24rpx;vertical-align:middle;color:inherit;}
.ui-chevron::after {content:"";position:absolute;left:7rpx;top:6rpx;width:10rpx;height:10rpx;border-top:2rpx solid currentColor;border-right:2rpx solid currentColor;transform:rotate(45deg);box-sizing:border-box;}
.ui-chevron.down::after {transform:rotate(135deg);top:4rpx;}
.ui-chevron.up::after {transform:rotate(-45deg);top:8rpx;}
.ui-chevron.left::after {transform:rotate(-135deg);left:9rpx;}
.disclosure-label {display:inline-flex;align-items:center;justify-content:center;gap:12rpx;}
.upload-category-parent>button:first-child,.category-group .grow {display:flex;align-items:center;gap:12rpx;}
.calendar-controls picker>view {display:flex;align-items:center;gap:10rpx;}
.purchase-calendar-nav>button {display:flex;align-items:center;justify-content:center;gap:0;}
.photo-edit-menu button {display:flex;align-items:center;gap:16rpx;}
.photo-edit-menu image {width:28rpx;height:28rpx;}
.upload-property-title>button>image {width:36rpx;height:36rpx;}
.editor-tools>button {flex:1;min-width:0;}
.editor-tools>button>image {width:36rpx;height:36rpx;}
.calendar-entry .calendar-look {position:relative;display:block;width:180rpx;height:180rpx;overflow:hidden;}
.calendar-entry .calendar-look>image {position:absolute;}
