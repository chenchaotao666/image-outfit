.look-author > text { margin-left: auto; letter-spacing: 0; font-size: 22rpx; color: #999; }
.look-author > button { font-size: 25rpx; padding: 10rpx 0 10rpx 5rpx; }
.look-footer > text:last-child { font-size: 26rpx; font-weight: 600; color: #333; }
.sheet-favorite-album .sheet-heading { display: none; }
.help-banner > image { mix-blend-mode: multiply; }
.calendar-controls picker { font-size: 30rpx; font-weight: 600; }
.calendar-controls .calendar-today { font-size: 28rpx; font-weight: 600; color: #ffb13d; }
.calendar-week { border-bottom: 1rpx solid #ddd; padding: 0 0 35rpx; margin-bottom: 40rpx; font-size: 28rpx; font-weight: 600; }
.calendar-grid { border: 0; gap: 3rpx; }
.calendar-grid .calendar-day { height: 135rpx; font-size: 25rpx; font-weight: 600; color: #444; box-shadow: inset 0 0 0 1rpx #ddd; padding: 6rpx; }
.calendar-view .album-heading { margin-top: 40rpx; padding: 40rpx 24rpx 25rpx; font-size: 30rpx; font-weight: 600; color: #333; }
.calendar-actions { display: flex; align-items: center; gap: 25rpx; }
.calendar-actions > button { font-size: 32rpx; min-width: 42rpx; height: 42rpx; line-height: 42rpx; }
.calendar-actions > .calendar-add { background: #333; color: white; }
.calendar-record { padding: 0 24rpx; }
.calendar-entry .calendar-entry-details { display: none; }
.calendar-list { padding-top: 60rpx; }
.calendar-record-date { font-size: 30rpx; font-weight: 600; margin-bottom: 35rpx; }
.calendar-list .calendar-record { margin-bottom: 55rpx; }
.calendar-list-tools { position: fixed; right: 40rpx; bottom: 70rpx; display: flex; gap: 20rpx; }
.calendar-list-tools > button { width: 78rpx; height: 78rpx; border-radius: 50%; background: #333; color: white; display: flex; align-items: center; justify-content: center; }
.calendar-list-tools image { width: 34rpx; height: 34rpx; filter: invert(1); }
.filter-funnel { width: 32rpx; height: 34rpx; background: white; clip-path: polygon(0 0,100% 0,65% 45%,65% 100%,35% 80%,35% 45%); }
.calendar-range { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; padding: 40rpx 0 60rpx; }
.calendar-range picker { flex: 1; background: #f5f5f5; padding: 20rpx 10rpx; font-size: 26rpx; text-align: center; }
.sheet-schedule .calendar-week { font-weight: 400; margin-bottom: 12rpx; padding-bottom: 15rpx; border: 0; }
.calendar-day > text { position: absolute; left: 8rpx; top: 4rpx; line-height: 1.3; z-index: 1; }
.calendar-view .album-heading > text { font-size: 30rpx; color: #333; font-weight: 600; }
