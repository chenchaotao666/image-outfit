page{background:#f5f6f6;color:#292d2e;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}view,text,image,button,input,scroll-view{box-sizing:border-box}button{font-size:28rpx;line-height:1.4;margin:0;padding:0;background:transparent;border-radius:0;color:inherit}button::after{border:0}image{display:block}button[disabled]{opacity:.4;color:inherit}.primary{display:flex;align-items:center;justify-content:center;min-height:84rpx;padding:18rpx 32rpx;border-radius:44rpx;background:linear-gradient(115deg,#00afc4,#00d8cb);color:#fff;font-weight:600;letter-spacing:2rpx}.secondary{padding:18rpx 30rpx;border:1rpx solid #0bb8bb;color:#05aeb4;border-radius:44rpx}.muted{color:#a0a4a5;font-size:24rpx}.eyebrow{font-size:20rpx;letter-spacing:5rpx;text-transform:uppercase}.title{font-size:38rpx;line-height:1.4;font-weight:700}.section-title{font-size:32rpx;font-weight:650}.teal{color:#00aeb8}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.column{display:flex;flex-direction:column;gap:16rpx}.card{background:#fff;border-radius:22rpx;overflow:hidden}.pad{padding:32rpx}.page-pad{padding:28rpx}.bottom-pad{padding-bottom:180rpx}.demo-label{display:inline-block;font-size:20rpx;padding:3rpx 14rpx;border-radius:20rpx;background:#e2f7f7;color:#008e97}.divider{height:1rpx;background:#edf0f0;margin:26rpx 0}.arrow{color:#b8bdbd;font-size:34rpx}.fixed-bottom{position:fixed;bottom:0;left:0;right:0;padding:22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid #eef1f1;z-index:20}.link{color:#009fa8;font-size:25rpx}.modal-shade{position:fixed;inset:0;background:rgba(0,0,0,.48);display:flex;align-items:flex-end;z-index:60}.sheet{width:100%;background:#fff;border-radius:30rpx 30rpx 0 0;padding:38rpx 38rpx calc(38rpx + env(safe-area-inset-bottom));max-height:86vh;overflow:auto}.sheet-head{border-left:7rpx solid #00cbbf;padding-left:20rpx}.sheet .close{font-size:40rpx;color:#999}.notice{font-size:24rpx;line-height:1.85;color:#818a8b}.empty{padding:100rpx 38rpx;text-align:center}.empty-symbol{font-size:85rpx;color:#b7dfdf;margin-bottom:30rpx}.tag{display:inline-block;background:#ecf9f8;color:#05a7af;font-size:22rpx;padding:5rpx 16rpx;border-radius:25rpx;margin:8rpx}.safe-space{height:env(safe-area-inset-bottom)}
.primary{width:100%}.secondary{display:block;width:100%}.home .hero-shade{background:linear-gradient(180deg,rgba(6,10,24,.15),transparent 35%,rgba(4,8,13,.08) 53%,#04080d 73%)}
.account-status{box-sizing:border-box;min-height:100vh;padding:100px 48rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.account-status button{margin-top:24rpx}
