  "chapters":[
    {"id":"white-color","number":"Ⅰ","title":"白色与彩色的搭配","intro":"白色让搭配显得轻快。选一件彩色上衣，再用白色裤装或内搭衔接，鞋包保持简洁。","tip":"有印花时，让其他单品保持纯色，整体更清楚。","imageTag":"white-color","sourceIds":["usu-principles","usu-elements"]},
    {"id":"dark-color","number":"Ⅱ","title":"深色与彩色的搭配","intro":"黑色、深蓝和深灰容易组合。用一件彩色上衣作重点，裤装与鞋包用深色呼应。","tip":"不想太沉闷，可以加白色鞋履或浅色内搭。","imageTag":"dark-color","sourceIds":["usu-principles","usu-elements"]},
    {"id":"tonal","number":"Ⅲ","title":"同色系的层次搭配","intro":"选择相近颜色，用深浅和面料区分层次。例如深棕上衣配浅棕裤装，或深蓝外套配浅蓝内搭。","tip":"让上装、裤装至少有一处深浅差别，避免全身混成一块。","imageTag":"tonal","sourceIds":["usu-principles","usu-elements"]}
  ]
